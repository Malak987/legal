diff --git a/supabase/migrations/20261025140000_supabase_security_storage.sql b/supabase/migrations/20261025140000_supabase_security_storage.sql
new file mode 100644
index 0000000..32845fa
--- /dev/null
+++ b/supabase/migrations/20261025140000_supabase_security_storage.sql
@@ -0,0 +1,633 @@
+-- =============================================================================
+-- Migration: 20261025140000_supabase_security_storage.sql
+-- Purpose:
+--   * replace broad PostgREST table grants with a least-privilege allowlist;
+--   * add status compatibility values without rewriting existing rows;
+--   * remove email-only Auth identity linking and provision client profiles
+--     only after email confirmation;
+--   * close the audited RLS/column-write gaps; and
+--   * provision the private PDF bucket used by the existing mobile document-review
+--     flow and JWT-verified Edge Function (the remote project has no bucket or objects).
+--
+-- Forward-only hardening. Apply only after the remote migration-history drift
+-- is reconciled and the complete sequence is tested on an isolated database.
+-- =============================================================================
+
+BEGIN;
+
+-- Harden the baseline trigger helper. Timestamp maintenance needs no elevated
+-- privileges; keep it invoker-rights and resolve built-ins from pg_catalog.
+CREATE OR REPLACE FUNCTION public.set_updated_at()
+RETURNS trigger
+LANGUAGE plpgsql
+SECURITY INVOKER
+SET search_path = pg_catalog
+AS $$
+BEGIN
+  NEW.updated_at := pg_catalog.now();
+  RETURN NEW;
+END;
+$$;
+
+-- The two baseline SECURITY DEFINER RPCs remain service_role-only, but their
+-- search paths are pinned before this migration is considered deployable.
+ALTER FUNCTION public.rpc_recalculate_lawyer_rating(text)
+  SET search_path = pg_catalog, public, pg_temp;
+ALTER FUNCTION public.rpc_reserve_booking_slots(
+  text, text, text, text, text, text, integer, numeric, text, text[], integer[]
+) SET search_path = pg_catalog, public, pg_temp;
+
+-- Preflight existing values before replacing constraints. This is deliberately
+-- read-only: do not normalize or rewrite an unknown legacy label. A non-zero
+-- count aborts the transaction with a count only, so operators can inspect the
+-- data through their approved process and choose an explicit forward plan.
+DO $$
+DECLARE
+  v_invalid_bookings bigint;
+  v_invalid_tasks bigint;
+BEGIN
+  SELECT count(*) INTO v_invalid_bookings
+    FROM public.bookings
+   WHERE status IS NULL
+      OR status NOT IN ('Pending', 'Confirmed', 'Active', 'Completed', 'Cancelled');
+  SELECT count(*) INTO v_invalid_tasks
+    FROM public.tasks
+   WHERE status IS NULL
+      OR status NOT IN ('Pending', 'In Progress', 'Completed', 'Cancelled', 'To Do', 'Done');
+  IF v_invalid_bookings > 0 OR v_invalid_tasks > 0 THEN
+    RAISE EXCEPTION 'Status preflight failed: % unsupported booking rows, % unsupported task rows; no data was changed',
+      v_invalid_bookings, v_invalid_tasks;
+  END IF;
+END;
+$$;
+
+-- Preserve verified status values and add the values used by the
+-- authenticated RPC/client contract. Keep legacy task labels until an explicitly
+-- approved data-conversion plan exists. No row is rewritten by this migration.
+ALTER TABLE public.bookings
+  DROP CONSTRAINT IF EXISTS bookings_status_check;
+ALTER TABLE public.bookings
+  ADD CONSTRAINT bookings_status_check
+  CHECK (status IN ('Pending', 'Confirmed', 'Active', 'Completed', 'Cancelled')) NOT VALID;
+ALTER TABLE public.bookings VALIDATE CONSTRAINT bookings_status_check;
+
+ALTER TABLE public.tasks
+  DROP CONSTRAINT IF EXISTS tasks_status_check;
+ALTER TABLE public.tasks
+  ADD CONSTRAINT tasks_status_check
+  CHECK (status IN ('Pending', 'In Progress', 'Completed', 'Cancelled', 'To Do', 'Done')) NOT VALID;
+ALTER TABLE public.tasks VALIDATE CONSTRAINT tasks_status_check;
+
+-- These fields are read by the Supabase clients and needed for reliable retries.
+ALTER TABLE public.lawyers
+  ADD COLUMN IF NOT EXISTS experience text NOT NULL DEFAULT '';
+ALTER TABLE public.bookings
+  ADD COLUMN IF NOT EXISTS idempotency_key_hash text;
+CREATE UNIQUE INDEX IF NOT EXISTS uq_bookings_user_idempotency_key_hash
+  ON public.bookings (user_id, idempotency_key_hash)
+  WHERE idempotency_key_hash IS NOT NULL;
+
+-- A user without an application profile has no application identity. Keep the
+-- privileged lookups in `private`; public compatibility functions are invoker-
+-- rights wrappers, matching the already-applied private-helper migration.
+CREATE SCHEMA IF NOT EXISTS private;
+REVOKE ALL ON SCHEMA private FROM PUBLIC, anon;
+GRANT USAGE ON SCHEMA private TO authenticated, service_role;
+
+CREATE OR REPLACE FUNCTION private.current_app_user_id()
+RETURNS text
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = pg_catalog, public
+AS $$
+  SELECT u.id
+    FROM public.users AS u
+   WHERE auth.uid() IS NOT NULL
+     AND (u.auth_user_id = auth.uid() OR u.id = auth.uid()::text)
+   ORDER BY (u.auth_user_id = auth.uid()) DESC
+   LIMIT 1;
+$$;
+
+CREATE OR REPLACE FUNCTION private.current_app_user_role()
+RETURNS text
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = pg_catalog, public
+AS $$
+  SELECT u.role
+    FROM public.users AS u
+   WHERE auth.uid() IS NOT NULL
+     AND (u.auth_user_id = auth.uid() OR u.id = auth.uid()::text)
+   ORDER BY (u.auth_user_id = auth.uid()) DESC
+   LIMIT 1;
+$$;
+
+CREATE OR REPLACE FUNCTION private.is_admin()
+RETURNS boolean
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = pg_catalog, public
+AS $$
+  SELECT COALESCE(auth.uid() IS NOT NULL AND private.current_app_user_role() = 'admin', false);
+$$;
+
+CREATE OR REPLACE FUNCTION private.is_lawyer_or_admin()
+RETURNS boolean
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = pg_catalog, public
+AS $$
+  SELECT COALESCE(private.current_app_user_role() IN ('lawyer', 'admin'), false);
+$$;
+
+CREATE OR REPLACE FUNCTION private.is_lawyer_owner(p_lawyer_id text)
+RETURNS boolean
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = pg_catalog, public
+AS $$
+  SELECT COALESCE(
+    private.current_app_user_role() = 'lawyer'
+    AND EXISTS (
+      SELECT 1
+        FROM public.lawyers AS l
+       WHERE l.id = p_lawyer_id
+         AND l.user_id = private.current_app_user_id()
+    ),
+    false
+  );
+$$;
+
+CREATE OR REPLACE FUNCTION private.is_eligible_case_owner(p_user_id text)
+RETURNS boolean
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = pg_catalog, public
+AS $$
+  SELECT COALESCE(
+    private.is_admin()
+    AND EXISTS (
+      SELECT 1
+        FROM public.users AS u
+       WHERE u.id = p_user_id
+         AND u.role IN ('client', 'lawyer')
+    ),
+    false
+  );
+$$;
+
+CREATE OR REPLACE FUNCTION public.current_app_user_id()
+RETURNS text LANGUAGE sql STABLE SECURITY INVOKER
+SET search_path = pg_catalog, public
+AS $$ SELECT private.current_app_user_id(); $$;
+CREATE OR REPLACE FUNCTION public.current_app_user_role()
+RETURNS text LANGUAGE sql STABLE SECURITY INVOKER
+SET search_path = pg_catalog, public
+AS $$ SELECT private.current_app_user_role(); $$;
+CREATE OR REPLACE FUNCTION public.is_admin()
+RETURNS boolean LANGUAGE sql STABLE SECURITY INVOKER
+SET search_path = pg_catalog, public
+AS $$ SELECT private.is_admin(); $$;
+CREATE OR REPLACE FUNCTION public.is_lawyer_or_admin()
+RETURNS boolean LANGUAGE sql STABLE SECURITY INVOKER
+SET search_path = pg_catalog, public
+AS $$ SELECT private.is_lawyer_or_admin(); $$;
+CREATE OR REPLACE FUNCTION public.is_lawyer_owner(p_lawyer_id text)
+RETURNS boolean LANGUAGE sql STABLE SECURITY INVOKER
+SET search_path = pg_catalog, public
+AS $$ SELECT private.is_lawyer_owner(p_lawyer_id); $$;
+CREATE OR REPLACE FUNCTION public.is_eligible_case_owner(p_user_id text)
+RETURNS boolean LANGUAGE sql STABLE SECURITY INVOKER
+SET search_path = pg_catalog, public
+AS $$ SELECT private.is_eligible_case_owner(p_user_id); $$;
+
+-- Email alone is not proof that a legacy account belongs to a new Auth user.
+-- A migration link requires a confirmed email AND an explicit legacy UID in
+-- admin-controlled raw_app_meta_data. Never read legacy_uid from raw_user_meta_data.
+-- Ordinary confirmed signups get a new, unprivileged client profile.
+CREATE OR REPLACE FUNCTION public.link_migrated_auth_user()
+RETURNS trigger
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog, public, pg_temp
+AS $$
+DECLARE
+  v_legacy_uid text;
+  v_name text;
+BEGIN
+  IF NEW.email IS NULL OR NEW.email_confirmed_at IS NULL THEN
+    RETURN NEW;
+  END IF;
+
+  -- An UPDATE OF email can be an unconfirmed address change. Do not copy it to
+  -- the application profile unless the confirmation timestamp also changes;
+  -- real GoTrue event semantics still require staging verification.
+  IF TG_OP = 'UPDATE'
+     AND OLD.email IS DISTINCT FROM NEW.email
+     AND OLD.email_confirmed_at IS NOT DISTINCT FROM NEW.email_confirmed_at THEN
+    RETURN NEW;
+  END IF;
+
+  -- If an already-linked user confirms a new address, sync only that confirmed
+  -- address. Role and identity mapping are never changed by this branch.
+  UPDATE public.users
+     SET email = NEW.email,
+         updated_at = now()
+   WHERE auth_user_id = NEW.id;
+  IF FOUND THEN
+    RETURN NEW;
+  END IF;
+
+  v_legacy_uid := NULLIF(trim(NEW.raw_app_meta_data ->> 'legacy_uid'), '');
+  IF v_legacy_uid IS NOT NULL
+     AND NEW.raw_app_meta_data ->> 'legacy_migration_verified' = 'true' THEN
+    UPDATE public.users
+       SET auth_user_id = NEW.id,
+           updated_at = now()
+     WHERE id = v_legacy_uid
+       AND auth_user_id IS NULL
+       AND lower(email) = lower(NEW.email);
+
+    -- A failed explicit mapping is left unlinked for manual reconciliation;
+    -- do not silently match another row by email or create a duplicate profile.
+    RETURN NEW;
+  END IF;
+
+  v_name := trim(COALESCE(NEW.raw_user_meta_data ->> 'name', ''));
+  IF char_length(v_name) < 2 THEN
+    v_name := split_part(NEW.email, '@', 1);
+  END IF;
+  IF char_length(trim(v_name)) < 2 THEN
+    v_name := 'Client';
+  END IF;
+
+  INSERT INTO public.users (id, uid, auth_user_id, name, email, role)
+  VALUES (NEW.id::text, NEW.id::text, NEW.id, v_name, NEW.email, 'client')
+  ON CONFLICT DO NOTHING;
+
+  RETURN NEW;
+END;
+$$;
+
+DROP TRIGGER IF EXISTS trg_auth_users_link_migrated ON auth.users;
+CREATE TRIGGER trg_auth_users_link_migrated
+  AFTER INSERT OR UPDATE OF email, email_confirmed_at ON auth.users
+  FOR EACH ROW
+  EXECUTE FUNCTION public.link_migrated_auth_user();
+
+-- Private helpers are available to authenticated policy evaluation, never anon.
+-- Public compatibility wrappers are invoker-rights only.
+REVOKE ALL ON FUNCTION private.current_app_user_id() FROM PUBLIC, anon, authenticated, service_role;
+REVOKE ALL ON FUNCTION private.current_app_user_role() FROM PUBLIC, anon, authenticated, service_role;
+REVOKE ALL ON FUNCTION private.is_admin() FROM PUBLIC, anon, authenticated, service_role;
+REVOKE ALL ON FUNCTION private.is_lawyer_or_admin() FROM PUBLIC, anon, authenticated, service_role;
+REVOKE ALL ON FUNCTION private.is_lawyer_owner(text) FROM PUBLIC, anon, authenticated, service_role;
+REVOKE ALL ON FUNCTION private.is_eligible_case_owner(text) FROM PUBLIC, anon, authenticated, service_role;
+GRANT EXECUTE ON FUNCTION private.current_app_user_id() TO authenticated, service_role;
+GRANT EXECUTE ON FUNCTION private.current_app_user_role() TO authenticated, service_role;
+GRANT EXECUTE ON FUNCTION private.is_admin() TO authenticated, service_role;
+GRANT EXECUTE ON FUNCTION private.is_lawyer_or_admin() TO authenticated, service_role;
+GRANT EXECUTE ON FUNCTION private.is_lawyer_owner(text) TO authenticated, service_role;
+GRANT EXECUTE ON FUNCTION private.is_eligible_case_owner(text) TO authenticated, service_role;
+
+REVOKE ALL ON FUNCTION public.current_app_user_id() FROM PUBLIC, anon, service_role;
+REVOKE ALL ON FUNCTION public.current_app_user_role() FROM PUBLIC, anon, service_role;
+REVOKE ALL ON FUNCTION public.is_admin() FROM PUBLIC, anon, service_role;
+REVOKE ALL ON FUNCTION public.is_lawyer_or_admin() FROM PUBLIC, anon, service_role;
+REVOKE ALL ON FUNCTION public.is_lawyer_owner(text) FROM PUBLIC, anon, service_role;
+REVOKE ALL ON FUNCTION public.is_eligible_case_owner(text) FROM PUBLIC, anon, service_role;
+GRANT EXECUTE ON FUNCTION public.current_app_user_id() TO authenticated;
+GRANT EXECUTE ON FUNCTION public.current_app_user_role() TO authenticated;
+GRANT EXECUTE ON FUNCTION public.is_admin() TO authenticated;
+GRANT EXECUTE ON FUNCTION public.is_lawyer_or_admin() TO authenticated;
+GRANT EXECUTE ON FUNCTION public.is_lawyer_owner(text) TO authenticated;
+GRANT EXECUTE ON FUNCTION public.is_eligible_case_owner(text) TO authenticated;
+
+REVOKE ALL ON FUNCTION public.link_migrated_auth_user() FROM PUBLIC, anon, authenticated, service_role;
+REVOKE ALL ON FUNCTION public.set_updated_at() FROM PUBLIC, anon, authenticated, service_role;
+
+-- Preserve only the two pre-existing trusted server-side RPC contracts. They
+-- remain unavailable to public and authenticated clients.
+REVOKE ALL ON FUNCTION public.rpc_recalculate_lawyer_rating(text)
+  FROM PUBLIC, anon, authenticated, service_role;
+GRANT EXECUTE ON FUNCTION public.rpc_recalculate_lawyer_rating(text)
+  TO service_role;
+REVOKE ALL ON FUNCTION public.rpc_reserve_booking_slots(
+  text, text, text, text, text, text, integer, numeric, text, text[], integer[]
+) FROM PUBLIC, anon, authenticated, service_role;
+GRANT EXECUTE ON FUNCTION public.rpc_reserve_booking_slots(
+  text, text, text, text, text, text, integer, numeric, text, text[], integer[]
+) TO service_role;
+
+-- Public reviews remain visible, but the raw table's user_id is not exposed to
+-- anon/authenticated PostgREST queries. Admin-only inspection uses a trusted RPC.
+CREATE OR REPLACE VIEW public.public_reviews
+WITH (security_barrier = true, security_invoker = true)
+AS
+SELECT id, user_name, lawyer_id, rating, comment, created_at, updated_at
+  FROM public.reviews;
+
+-- Replace policies that permitted broad row/column changes.
+DROP POLICY IF EXISTS users_insert_self_client_or_admin ON public.users;
+DROP POLICY IF EXISTS users_update_self_or_admin ON public.users;
+DROP POLICY IF EXISTS users_delete_admin_only ON public.users;
+CREATE POLICY users_update_self_or_admin ON public.users
+  FOR UPDATE TO authenticated
+  USING (id = public.current_app_user_id() OR public.is_admin())
+  WITH CHECK (id = public.current_app_user_id() OR public.is_admin());
+
+DROP POLICY IF EXISTS cases_insert_owner_or_admin ON public.cases;
+CREATE POLICY cases_insert_owner_or_admin ON public.cases
+  FOR INSERT TO authenticated
+  WITH CHECK (
+    (user_id = public.current_app_user_id()
+      AND public.current_app_user_role() IN ('client', 'lawyer'))
+    OR (public.is_admin() AND public.is_eligible_case_owner(user_id))
+  );
+
+-- Booking and money mutations are RPC-only. The old table-wide admin policies
+-- allowed clients to bypass schedule, price, and ledger invariants.
+DROP POLICY IF EXISTS bookings_write_admin_only ON public.bookings;
+DROP POLICY IF EXISTS booking_slots_write_admin_only ON public.booking_slots;
+DROP POLICY IF EXISTS wallets_write_admin_only ON public.wallets;
+DROP POLICY IF EXISTS wallet_tx_write_admin_only ON public.wallet_transactions;
+DROP POLICY IF EXISTS wallet_idempotency_write_admin_only ON public.wallet_idempotency;
+
+-- Chat metadata is immutable to participants; atomic RPCs append a message and
+-- update last_message together. A participant may delete the shared chat, as
+-- the existing route permits; its messages cascade in the same transaction.
+DROP POLICY IF EXISTS chats_insert_participant_or_admin ON public.chats;
+DROP POLICY IF EXISTS chats_update_participant_or_admin ON public.chats;
+DROP POLICY IF EXISTS chats_delete_admin_only ON public.chats;
+DROP POLICY IF EXISTS chats_delete_participant_or_admin ON public.chats;
+CREATE POLICY chats_delete_participant_or_admin ON public.chats
+  FOR DELETE TO authenticated
+  USING (public.current_app_user_id() = ANY(participants) OR public.is_admin());
+DROP POLICY IF EXISTS chat_messages_insert_participant_or_admin ON public.chat_messages;
+DROP POLICY IF EXISTS chat_messages_delete_admin_only ON public.chat_messages;
+
+-- Reviews can only be submitted/moderated through role-checked RPCs.
+DROP POLICY IF EXISTS reviews_insert_owner_or_admin ON public.reviews;
+DROP POLICY IF EXISTS reviews_update_owner_or_admin ON public.reviews;
+DROP POLICY IF EXISTS reviews_delete_owner_or_admin ON public.reviews;
+
+-- Subscription state is commercial data. Owners can only cancel through RPC;
+-- they cannot change plan fields or activate a subscription directly.
+DROP POLICY IF EXISTS subscriptions_insert_owner_pending_or_admin ON public.subscriptions;
+DROP POLICY IF EXISTS subscriptions_update_owner_cancel_or_admin ON public.subscriptions;
+DROP POLICY IF EXISTS subscriptions_delete_admin_only ON public.subscriptions;
+
+-- Keep the public plan catalogue SELECT policy separate from admin writes so
+-- authenticated SELECT does not overlap a permissive FOR ALL policy.
+DROP POLICY IF EXISTS plans_write_admin_only ON public.plans;
+DROP POLICY IF EXISTS plans_insert_admin_only ON public.plans;
+DROP POLICY IF EXISTS plans_update_admin_only ON public.plans;
+DROP POLICY IF EXISTS plans_delete_admin_only ON public.plans;
+CREATE POLICY plans_insert_admin_only ON public.plans
+  FOR INSERT TO authenticated
+  WITH CHECK (public.is_admin());
+CREATE POLICY plans_update_admin_only ON public.plans
+  FOR UPDATE TO authenticated
+  USING (public.is_admin())
+  WITH CHECK (public.is_admin());
+CREATE POLICY plans_delete_admin_only ON public.plans
+  FOR DELETE TO authenticated
+  USING (public.is_admin());
+
+-- Notification owners may update only `read` (column grants below) and delete
+-- their own notification. Admin content/recipient changes are RPC-only.
+DROP POLICY IF EXISTS notifications_update_owner_or_admin ON public.notifications;
+DROP POLICY IF EXISTS notifications_update_read_owner_or_admin ON public.notifications;
+CREATE POLICY notifications_update_read_owner_or_admin ON public.notifications
+  FOR UPDATE TO authenticated
+  USING (user_id = public.current_app_user_id() OR public.is_admin())
+  WITH CHECK (user_id = public.current_app_user_id() OR public.is_admin());
+
+-- The legacy earnings endpoint is self-or-admin, not lawyer-only. There is no
+-- direct financial write grant; a trusted settlement integration is still not
+-- implemented.
+DROP POLICY IF EXISTS earnings_select_lawyer_owner_or_admin ON public.earnings;
+DROP POLICY IF EXISTS earnings_select_owner_or_admin ON public.earnings;
+CREATE POLICY earnings_select_owner_or_admin ON public.earnings
+  FOR SELECT TO authenticated
+  USING (user_id = public.current_app_user_id() OR public.is_admin());
+DROP POLICY IF EXISTS earnings_write_admin_only ON public.earnings;
+
+-- Availability writes must be tied to the actual public.lawyers.user_id owner,
+-- not merely to any account whose role says "lawyer".
+DROP POLICY IF EXISTS availability_write_lawyer_or_admin ON public.availability;
+DROP POLICY IF EXISTS availability_insert_owner_or_admin ON public.availability;
+DROP POLICY IF EXISTS availability_update_owner_or_admin ON public.availability;
+DROP POLICY IF EXISTS availability_delete_owner_or_admin ON public.availability;
+CREATE POLICY availability_insert_owner_or_admin ON public.availability
+  FOR INSERT TO authenticated
+  WITH CHECK (public.is_admin() OR public.is_lawyer_owner(lawyer_id));
+CREATE POLICY availability_update_owner_or_admin ON public.availability
+  FOR UPDATE TO authenticated
+  USING (public.is_admin() OR public.is_lawyer_owner(lawyer_id))
+  WITH CHECK (public.is_admin() OR public.is_lawyer_owner(lawyer_id));
+CREATE POLICY availability_delete_owner_or_admin ON public.availability
+  FOR DELETE TO authenticated
+  USING (public.is_admin() OR public.is_lawyer_owner(lawyer_id));
+
+-- Least-privilege grants. RLS does not protect TRUNCATE, REFERENCES, or
+-- TRIGGER privileges, so none is granted to the API roles. service_role remains
+-- a trusted-server-only role and is limited to DML (it still bypasses RLS).
+REVOKE ALL ON ALL TABLES IN SCHEMA public FROM PUBLIC, anon, authenticated, service_role;
+REVOKE ALL ON ALL SEQUENCES IN SCHEMA public FROM PUBLIC, anon, authenticated, service_role;
+REVOKE CREATE ON SCHEMA public FROM PUBLIC, anon, authenticated, service_role;
+GRANT USAGE ON SCHEMA public TO anon, authenticated, service_role;
+
+GRANT SELECT, INSERT, UPDATE, DELETE
+  ON public.users, public.lawyers, public.cases, public.bookings,
+     public.booking_slots, public.tasks, public.chats, public.chat_messages,
+     public.reviews, public.favorites, public.wallets, public.wallet_transactions,
+     public.wallet_idempotency, public.plans, public.subscriptions,
+     public.notifications, public.earnings, public.availability
+  TO service_role;
+
+-- Public catalogue data. Never expose lawyers.user_id through PostgREST.
+-- These columns match the mobile catalogue allowlist; owner/admin RPCs and the
+-- trusted Express adapter continue to use the full row under their own role.
+GRANT SELECT (id, name, specialty, price, price_value, image, rating, location,
+              experience, bio, is_popular, is_top)
+  ON public.lawyers TO anon, authenticated;
+GRANT SELECT ON public.plans, public.availability TO anon;
+
+-- The public, security-invoker view exposes review display fields only. Grant
+-- those same safe base columns so the view remains subject to table RLS.
+GRANT SELECT (id, user_name, lawyer_id, rating, comment, created_at, updated_at)
+  ON public.reviews TO anon, authenticated;
+GRANT SELECT ON public.public_reviews TO anon, authenticated;
+
+-- Authenticated read surface; RLS limits rows, and column grants limit public
+-- lawyers/reviews. wallet_idempotency has no client table grant.
+GRANT SELECT ON public.users, public.cases, public.booking_slots,
+  public.tasks, public.chats, public.chat_messages, public.favorites,
+  public.wallets, public.plans, public.subscriptions,
+  public.notifications, public.earnings, public.availability
+  TO authenticated;
+GRANT SELECT (id, user_id, type, amount, description, balance, currency,
+              created_at, updated_at)
+  ON public.wallet_transactions TO authenticated;
+-- Keep the booking idempotency digest private while preserving the existing
+-- owner/admin booking read shape.
+GRANT SELECT (id, user_id, lawyer_id, lawyer_name, date, time, hours,
+              total_price, status, slot_keys, created_at, updated_at)
+  ON public.bookings TO authenticated;
+-- Direct chat deletion is intentionally permitted by the participant/admin
+-- RLS policy above; message rows cascade atomically from the chat delete.
+GRANT DELETE ON public.chats TO authenticated;
+
+-- Self-service profile changes cannot change identity, email, or role. Admins
+-- use narrowly-scoped RPCs for role/email/Auth-user operations.
+GRANT UPDATE (name, phone, avatar, address) ON public.users TO authenticated;
+
+-- Public lawyer/plan catalog management is admin-only by RLS. The ownership
+-- fields are intentionally immutable in direct updates.
+GRANT INSERT (user_id, name, specialty, experience, price, price_value, image,
+              rating, location, bio, is_popular, is_top)
+  ON public.lawyers TO authenticated;
+GRANT UPDATE (name, specialty, experience, price, price_value, image, rating,
+              location, bio, is_popular, is_top)
+  ON public.lawyers TO authenticated;
+GRANT DELETE ON public.lawyers TO authenticated;
+GRANT INSERT (title, price, price_value, color, features, is_popular)
+  ON public.plans TO authenticated;
+GRANT UPDATE (title, price, price_value, color, features, is_popular)
+  ON public.plans TO authenticated;
+GRANT DELETE ON public.plans TO authenticated;
+
+-- Owner-scoped case/task CRUD. Ownership and status changes use dedicated RPCs;
+-- CREATED/UPDATED metadata is server-managed by defaults/triggers.
+GRANT INSERT (user_id, title, description, client_name, case_type, priority, status, due_date)
+  ON public.cases TO authenticated;
+GRANT UPDATE (title, description, client_name, case_type, priority, due_date)
+  ON public.cases TO authenticated;
+GRANT DELETE ON public.cases TO authenticated;
+GRANT INSERT (user_id, title, description, due_date, priority, status)
+  ON public.tasks TO authenticated;
+GRANT UPDATE (title, description, due_date, priority)
+  ON public.tasks TO authenticated;
+GRANT DELETE ON public.tasks TO authenticated;
+
+-- Favorites are idempotent via the unique constraint; clients cannot reassign
+-- or rewrite an existing favorite.
+GRANT INSERT (user_id, lawyer_id) ON public.favorites TO authenticated;
+GRANT DELETE ON public.favorites TO authenticated;
+
+-- A client can only append/modify its own availability rows. The lawyer_id is
+-- intentionally not updateable, so a lawyer cannot move another owner's row.
+GRANT INSERT (lawyer_id, lawyer_name, date, slots) ON public.availability TO authenticated;
+GRANT UPDATE (lawyer_name, date, slots) ON public.availability TO authenticated;
+GRANT DELETE ON public.availability TO authenticated;
+
+-- Admin-created notifications are row-scoped by RLS. Owners can only change
+-- the read flag, not title/content/recipient.
+GRANT INSERT (user_id, title, content, type, icon, read)
+  ON public.notifications TO authenticated;
+GRANT UPDATE (read) ON public.notifications TO authenticated;
+GRANT DELETE ON public.notifications TO authenticated;
+
+-- Tasks/cases state changes and all booking/chat/review/wallet/subscription
+-- mutations are exposed only through the transactional functions added in the
+-- next migration. Never grant clients direct UPDATE on protected fields.
+
+-- Default privileges for future objects created by this migration owner.
+ALTER DEFAULT PRIVILEGES IN SCHEMA public
+  REVOKE ALL ON TABLES FROM PUBLIC, anon, authenticated, service_role;
+ALTER DEFAULT PRIVILEGES IN SCHEMA public
+  REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC, anon, authenticated, service_role;
+ALTER DEFAULT PRIVILEGES IN SCHEMA storage
+  REVOKE ALL ON TABLES FROM PUBLIC, anon, authenticated, service_role;
+ALTER DEFAULT PRIVILEGES IN SCHEMA storage
+  REVOKE ALL ON SEQUENCES FROM PUBLIC, anon, authenticated, service_role;
+
+-- Private PDF storage is required by legal_app's consent-gated document
+-- review flow. Authenticated clients may read/delete only their own objects;
+-- they cannot INSERT arbitrary bytes directly. The document-upload Edge
+-- Function validates the byte signature first and then uses a server-side
+-- service-role client for Storage insertion. That key is never shipped to a
+-- client. service_role remains a trusted server role and is granted only the
+-- DML needed for the upload/cleanup path; it continues to bypass RLS.
+REVOKE ALL ON SCHEMA storage FROM PUBLIC, anon, authenticated, service_role;
+REVOKE ALL ON ALL TABLES IN SCHEMA storage FROM PUBLIC, anon, authenticated, service_role;
+REVOKE ALL ON ALL SEQUENCES IN SCHEMA storage FROM PUBLIC, anon, authenticated, service_role;
+GRANT USAGE ON SCHEMA storage TO authenticated, service_role;
+GRANT SELECT, DELETE ON storage.objects TO authenticated;
+GRANT SELECT, INSERT, UPDATE, DELETE ON storage.objects TO service_role;
+GRANT SELECT ON storage.buckets TO service_role;
+
+-- Explicitly remove any previously granted analytics access, while tolerating
+-- Storage versions that do not install this internal relation.
+DO $$
+BEGIN
+  IF to_regclass('storage.buckets_analytics') IS NOT NULL THEN
+    EXECUTE 'REVOKE ALL ON TABLE storage.buckets_analytics FROM PUBLIC, anon, authenticated, service_role';
+  END IF;
+END;
+$$;
+
+-- Never overwrite an existing bucket's privacy/limits as a side effect of an
+-- application migration. If the ID already exists with different settings,
+-- stop and require an explicit operator reconciliation.
+INSERT INTO storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
+VALUES ('legal-documents', 'legal-documents', false, 10485760, ARRAY['application/pdf'])
+ON CONFLICT (id) DO NOTHING;
+
+DO $$
+DECLARE
+  v_bucket storage.buckets%ROWTYPE;
+BEGIN
+  SELECT * INTO v_bucket FROM storage.buckets WHERE id = 'legal-documents';
+  IF NOT FOUND
+     OR v_bucket.name <> 'legal-documents'
+     OR v_bucket.public IS DISTINCT FROM false
+     OR v_bucket.file_size_limit IS DISTINCT FROM 10485760
+     OR v_bucket.allowed_mime_types IS DISTINCT FROM ARRAY['application/pdf']::text[] THEN
+    RAISE EXCEPTION 'Existing legal-documents bucket does not match the reviewed private PDF configuration';
+  END IF;
+END;
+$$;
+
+-- The object name must be exactly <app-user-id>/documents/<opaque-name>.pdf.
+-- Storage's allowed_mime_types and file_size_limit enforce the MIME/size limits;
+-- path checks below prevent arbitrary folders and extension disguises.
+DROP POLICY IF EXISTS legal_documents_read_owner_or_admin ON storage.objects;
+CREATE POLICY legal_documents_read_owner_or_admin ON storage.objects
+  FOR SELECT TO authenticated
+  USING (
+    bucket_id = 'legal-documents'
+    AND array_length(storage.foldername(name), 1) = 2
+    AND (storage.foldername(name))[2] = 'documents'
+    AND name ~ '^[A-Za-z0-9_-]+/documents/[A-Za-z0-9_-]+[.]pdf$'
+    AND ((storage.foldername(name))[1] = public.current_app_user_id()
+      OR public.is_admin())
+  );
+
+-- Clients cannot insert directly: the trusted Edge Function checks PDF bytes
+-- before using its server-only Storage client. Dropping any legacy policy also
+-- makes re-verification fail closed if broad grants are later reintroduced.
+DROP POLICY IF EXISTS legal_documents_insert_owner_or_admin ON storage.objects;
+
+-- No UPDATE policy/grant: object names are opaque and overwrite is disabled.
+
+DROP POLICY IF EXISTS legal_documents_delete_owner_or_admin ON storage.objects;
+CREATE POLICY legal_documents_delete_owner_or_admin ON storage.objects
+  FOR DELETE TO authenticated
+  USING (
+    bucket_id = 'legal-documents'
+    AND array_length(storage.foldername(name), 1) = 2
+    AND (storage.foldername(name))[2] = 'documents'
+    AND name ~ '^[A-Za-z0-9_-]+/documents/[A-Za-z0-9_-]+[.]pdf$'
+    AND ((storage.foldername(name))[1] = public.current_app_user_id()
+      OR public.is_admin())
+  );
+
+COMMIT;
diff --git a/supabase/migrations/20261025141000_identity_owner_lawyer_access.sql b/supabase/migrations/20261025141000_identity_owner_lawyer_access.sql
new file mode 100644
index 0000000..0815363
--- /dev/null
+++ b/supabase/migrations/20261025141000_identity_owner_lawyer_access.sql
@@ -0,0 +1,432 @@
+-- Migration: 20261025141000_identity_owner_lawyer_access.sql
+-- Forward-only identity/owner/lawyer policies. No user data is rewritten.
+-- Uses only existing `users`, `lawyers`, `cases`, and `bookings` tables.
+-- No data rows are intentionally changed by this transaction.
+
+BEGIN;
+
+-- A profile is required for application identity. Never fall back to the Auth
+-- UUID when the trusted profile is absent or carries an unsupported role.
+CREATE OR REPLACE FUNCTION private.current_app_user_id()
+RETURNS text
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = pg_catalog, public
+AS $function$
+  WITH matched_profile AS (
+    SELECT u.id, u.role
+    FROM public.users AS u
+    WHERE auth.uid() IS NOT NULL
+      AND (u.auth_user_id = auth.uid() OR u.id = auth.uid()::text)
+    ORDER BY (u.auth_user_id = auth.uid()) DESC NULLS LAST,
+             (u.id = auth.uid()::text) DESC NULLS LAST
+    LIMIT 1
+  )
+  SELECT id
+  FROM matched_profile
+  WHERE role IN ('client', 'lawyer', 'admin', 'owner');
+$function$;
+
+CREATE OR REPLACE FUNCTION private.current_app_user_role()
+RETURNS text
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = pg_catalog, public
+AS $function$
+  WITH matched_profile AS (
+    SELECT u.role
+    FROM public.users AS u
+    WHERE auth.uid() IS NOT NULL
+      AND (u.auth_user_id = auth.uid() OR u.id = auth.uid()::text)
+    ORDER BY (u.auth_user_id = auth.uid()) DESC NULLS LAST,
+             (u.id = auth.uid()::text) DESC NULLS LAST
+    LIMIT 1
+  )
+  SELECT role
+  FROM matched_profile
+  WHERE role IN ('client', 'lawyer', 'admin', 'owner');
+$function$;
+
+-- `admin` remains a compatibility role. It is not renamed or converted.
+-- New `owner` profiles receive the same DB authorization used by existing
+-- owner/admin policies; the partial unique index below allows at most one.
+ALTER TABLE public.users DROP CONSTRAINT users_role_check;
+ALTER TABLE public.users
+  ADD CONSTRAINT users_role_check
+  CHECK (role IN ('client', 'lawyer', 'admin', 'owner')) NOT VALID;
+ALTER TABLE public.users VALIDATE CONSTRAINT users_role_check;
+
+CREATE UNIQUE INDEX users_single_owner_key
+  ON public.users (role)
+  WHERE role = 'owner';
+
+CREATE OR REPLACE FUNCTION private.is_admin()
+RETURNS boolean
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = pg_catalog, public
+AS $function$
+  SELECT COALESCE(
+    private.current_app_user_role() IN ('admin', 'owner'),
+    false
+  );
+$function$;
+
+CREATE OR REPLACE FUNCTION private.is_lawyer_or_admin()
+RETURNS boolean
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = pg_catalog, public
+AS $function$
+  SELECT COALESCE(
+    private.current_app_user_role() IN ('lawyer', 'admin', 'owner'),
+    false
+  );
+$function$;
+
+-- Keep existing admin role changes for client/lawyer accounts compatible, but
+-- reserve both promotion to and demotion from owner for a trusted SQL/service
+-- role. Ordinary authenticated clients cannot set identity or role columns.
+CREATE OR REPLACE FUNCTION public.guard_user_identity_fields()
+RETURNS trigger
+LANGUAGE plpgsql
+SET search_path = pg_catalog, public
+AS $function$
+BEGIN
+  IF (OLD.role = 'owner' OR NEW.role = 'owner') AND (
+    NEW.id IS DISTINCT FROM OLD.id
+    OR NEW.uid IS DISTINCT FROM OLD.uid
+    OR NEW.auth_user_id IS DISTINCT FROM OLD.auth_user_id
+    OR NEW.role IS DISTINCT FROM OLD.role
+  ) THEN
+    -- SECURITY DEFINER RPCs run with current_user set to their function owner
+    -- (often postgres). That alone is not operator authority: distinguish a
+    -- service-role JWT from authenticated callers, and allow direct SQL
+    -- operator sessions only when no PostgREST JWT role is present.
+    IF (current_user = 'service_role' AND auth.role() = 'service_role')
+       OR (session_user = 'postgres' AND auth.role() IS NULL) THEN
+      RETURN NEW;
+    END IF;
+    RAISE EXCEPTION 'The owner identity and role can only be changed by a trusted provisioning process'
+      USING ERRCODE = '42501';
+  END IF;
+
+  IF (
+    NEW.id IS DISTINCT FROM OLD.id
+    OR NEW.uid IS DISTINCT FROM OLD.uid
+    OR NEW.auth_user_id IS DISTINCT FROM OLD.auth_user_id
+    OR NEW.role IS DISTINCT FROM OLD.role
+  ) AND NOT COALESCE(
+    current_setting('legal.auth_user_link_in_progress', true) = 'true'
+    AND current_user = 'postgres'
+    AND pg_trigger_depth() > 1,
+    false
+  ) AND NOT public.is_admin() THEN
+    RAISE EXCEPTION 'Identity and role fields can only be changed by an administrator'
+      USING ERRCODE = '42501';
+  END IF;
+  RETURN NEW;
+END;
+$function$;
+
+-- The live users INSERT policy permits authenticated admins to create users,
+-- so reserve owner creation itself for the trusted provisioning path.
+CREATE OR REPLACE FUNCTION public.guard_owner_profile_insert()
+RETURNS trigger
+LANGUAGE plpgsql
+SECURITY INVOKER
+SET search_path = pg_catalog, public
+AS $function$
+BEGIN
+  IF NEW.role = 'owner'
+     AND NOT COALESCE(
+       (current_user = 'service_role' AND auth.role() = 'service_role')
+       OR (session_user = 'postgres' AND auth.role() IS NULL),
+       false
+     ) THEN
+    RAISE EXCEPTION 'The owner profile can only be created by a trusted provisioning process'
+      USING ERRCODE = '42501';
+  END IF;
+  RETURN NEW;
+END;
+$function$;
+REVOKE ALL ON FUNCTION public.guard_owner_profile_insert() FROM PUBLIC, anon, authenticated;
+DROP TRIGGER IF EXISTS guard_owner_profile_insert_trigger ON public.users;
+CREATE TRIGGER guard_owner_profile_insert_trigger
+  BEFORE INSERT ON public.users
+  FOR EACH ROW
+  EXECUTE FUNCTION public.guard_owner_profile_insert();
+
+-- RLS permits administrators to delete users, so reserve deletion of the
+-- singleton owner account for the same trusted operator path as provisioning.
+CREATE OR REPLACE FUNCTION public.guard_owner_profile_delete()
+RETURNS trigger
+LANGUAGE plpgsql
+SECURITY INVOKER
+SET search_path = pg_catalog, public
+AS $function$
+BEGIN
+  IF OLD.role = 'owner'
+     AND NOT COALESCE(
+       (current_user = 'service_role' AND auth.role() = 'service_role')
+       OR (session_user = 'postgres' AND auth.role() IS NULL),
+       false
+     ) THEN
+    RAISE EXCEPTION 'The owner profile can only be deleted by a trusted provisioning process'
+      USING ERRCODE = '42501';
+  END IF;
+  RETURN OLD;
+END;
+$function$;
+REVOKE ALL ON FUNCTION public.guard_owner_profile_delete() FROM PUBLIC, anon, authenticated;
+DROP TRIGGER IF EXISTS guard_owner_profile_delete_trigger ON public.users;
+CREATE TRIGGER guard_owner_profile_delete_trigger
+  BEFORE DELETE ON public.users
+  FOR EACH ROW
+  EXECUTE FUNCTION public.guard_owner_profile_delete();
+
+-- Do not claim a legacy profile on email equality. Legacy linking requires an
+-- exact profile ID in admin-controlled raw_app_meta_data plus a confirmed,
+-- matching email. Email and phone signups create profiles only after the
+-- corresponding contact is confirmed. Only a trusted server-controlled
+-- signup_role can request a lawyer profile; raw_user_meta_data.role is ignored.
+-- Phone-only signups are always clients, and all other values (including
+-- admin/owner) fail closed to client.
+CREATE OR REPLACE FUNCTION public.link_migrated_auth_user()
+RETURNS trigger
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog, public
+AS $function$
+DECLARE
+  v_legacy_uid text;
+  v_name text;
+  v_signup_role text;
+  v_email_confirmed boolean;
+  v_phone_confirmed boolean;
+BEGIN
+  v_email_confirmed := NEW.email IS NOT NULL AND NEW.email_confirmed_at IS NOT NULL;
+  v_phone_confirmed := NEW.phone IS NOT NULL AND NEW.phone_confirmed_at IS NOT NULL;
+  IF NOT v_email_confirmed AND NOT v_phone_confirmed THEN
+    RETURN NEW;
+  END IF;
+
+  -- Do not treat an unconfirmed address/number change as a verified identity.
+  -- A simultaneous confirmation of the other contact may still provision a
+  -- client profile, but only already-confirmed contact values are persisted.
+  IF TG_OP = 'UPDATE'
+     AND OLD.email IS DISTINCT FROM NEW.email
+     AND OLD.email_confirmed_at IS NOT DISTINCT FROM NEW.email_confirmed_at
+     AND OLD.phone_confirmed_at IS NOT DISTINCT FROM NEW.phone_confirmed_at THEN
+    RETURN NEW;
+  END IF;
+  IF TG_OP = 'UPDATE'
+     AND OLD.phone IS DISTINCT FROM NEW.phone
+     AND OLD.phone_confirmed_at IS NOT DISTINCT FROM NEW.phone_confirmed_at
+     AND OLD.email_confirmed_at IS NOT DISTINCT FROM NEW.email_confirmed_at THEN
+    RETURN NEW;
+  END IF;
+
+  -- Keep an existing explicit Auth mapping; update only confirmed contacts,
+  -- never the stored application role or identity columns.
+  UPDATE public.users
+     SET email = CASE WHEN v_email_confirmed THEN NEW.email ELSE email END,
+         phone = CASE WHEN v_phone_confirmed THEN NEW.phone ELSE phone END,
+         updated_at = now()
+   WHERE auth_user_id = NEW.id;
+  IF FOUND THEN
+    RETURN NEW;
+  END IF;
+
+  -- Legacy rows require both an administrator-verified exact ID and a
+  -- confirmed, matching email. Phone alone is never used to claim legacy data.
+  v_legacy_uid := NULLIF(btrim(NEW.raw_app_meta_data ->> 'legacy_uid'), '');
+  IF v_email_confirmed
+     AND v_legacy_uid IS NOT NULL
+     AND NEW.raw_app_meta_data ->> 'legacy_migration_verified' = 'true' THEN
+    -- The row's existing identity guard only permits identity updates from an
+    -- admin. Mark this exact, nested Auth trigger update rather than broadly
+    -- trusting current_user=postgres (which SECURITY DEFINER RPCs also use).
+    PERFORM set_config('legal.auth_user_link_in_progress', 'true', true);
+    UPDATE public.users
+       SET auth_user_id = NEW.id,
+           email = NEW.email,
+           updated_at = now()
+     WHERE id = v_legacy_uid
+       AND auth_user_id IS NULL
+       AND lower(email) = lower(NEW.email);
+    PERFORM set_config('legal.auth_user_link_in_progress', 'false', true);
+    -- A failed explicit mapping is left unlinked for manual reconciliation.
+    RETURN NEW;
+  END IF;
+
+  v_name := btrim(COALESCE(NEW.raw_user_meta_data ->> 'name', ''));
+  IF char_length(v_name) < 2 THEN
+    v_name := CASE
+      WHEN v_email_confirmed THEN split_part(NEW.email, '@', 1)
+      ELSE 'Client'
+    END;
+  END IF;
+  IF char_length(btrim(v_name)) < 2 THEN
+    v_name := 'Client';
+  END IF;
+
+  -- Lawyer onboarding is an email-confirmed flow assigned by the trusted
+  -- server. A verified phone signup can create a client profile only.
+  v_signup_role := CASE
+    WHEN v_email_confirmed
+     AND NEW.raw_app_meta_data ->> 'signup_role' = 'lawyer' THEN 'lawyer'
+    ELSE 'client'
+  END;
+
+  INSERT INTO public.users (id, uid, auth_user_id, name, email, phone, role)
+  VALUES (
+    NEW.id::text,
+    NEW.id::text,
+    NEW.id,
+    v_name,
+    CASE WHEN v_email_confirmed THEN NEW.email ELSE '' END,
+    CASE WHEN v_phone_confirmed THEN NEW.phone ELSE '' END,
+    v_signup_role
+  )
+  ON CONFLICT DO NOTHING;
+
+  RETURN NEW;
+END;
+$function$;
+
+DROP TRIGGER IF EXISTS trg_auth_users_link_migrated ON auth.users;
+CREATE TRIGGER trg_auth_users_link_migrated
+  AFTER INSERT OR UPDATE OF email, email_confirmed_at, phone, phone_confirmed_at ON auth.users
+  FOR EACH ROW
+  EXECUTE FUNCTION public.link_migrated_auth_user();
+
+REVOKE ALL ON FUNCTION private.current_app_user_id() FROM PUBLIC, anon;
+REVOKE ALL ON FUNCTION private.current_app_user_role() FROM PUBLIC, anon;
+REVOKE ALL ON FUNCTION private.is_admin() FROM PUBLIC, anon;
+REVOKE ALL ON FUNCTION private.is_lawyer_or_admin() FROM PUBLIC, anon;
+GRANT EXECUTE ON FUNCTION private.current_app_user_id() TO authenticated, service_role;
+GRANT EXECUTE ON FUNCTION private.current_app_user_role() TO authenticated, service_role;
+GRANT EXECUTE ON FUNCTION private.is_admin() TO authenticated, service_role;
+GRANT EXECUTE ON FUNCTION private.is_lawyer_or_admin() TO authenticated, service_role;
+REVOKE ALL ON FUNCTION public.link_migrated_auth_user() FROM PUBLIC, anon, authenticated;
+
+-- Owner policies must be role-bound before any assigned-lawyer policy is
+-- added. A profile with a matching user_id is a client owner only when its
+-- server-owned role is `client`; admin/owner access remains explicit.
+DROP POLICY IF EXISTS cases_select_owner_or_admin ON public.cases;
+CREATE POLICY cases_select_owner_or_admin ON public.cases
+  FOR SELECT TO authenticated
+  USING (
+    private.is_admin()
+    OR (
+      private.current_app_user_role() = 'client'
+      AND user_id = private.current_app_user_id()
+    )
+  );
+
+DROP POLICY IF EXISTS cases_insert_owner_or_admin ON public.cases;
+CREATE POLICY cases_insert_owner_or_admin ON public.cases
+  FOR INSERT TO authenticated
+  WITH CHECK (
+    private.is_admin()
+    OR (
+      private.current_app_user_role() = 'client'
+      AND user_id = private.current_app_user_id()
+    )
+  );
+
+DROP POLICY IF EXISTS cases_update_owner_or_admin ON public.cases;
+CREATE POLICY cases_update_owner_or_admin ON public.cases
+  FOR UPDATE TO authenticated
+  USING (
+    private.is_admin()
+    OR (
+      private.current_app_user_role() = 'client'
+      AND user_id = private.current_app_user_id()
+    )
+  )
+  WITH CHECK (
+    private.is_admin()
+    OR (
+      private.current_app_user_role() = 'client'
+      AND user_id = private.current_app_user_id()
+    )
+  );
+
+DROP POLICY IF EXISTS cases_delete_owner_or_admin ON public.cases;
+CREATE POLICY cases_delete_owner_or_admin ON public.cases
+  FOR DELETE TO authenticated
+  USING (
+    private.is_admin()
+    OR (
+      private.current_app_user_role() = 'client'
+      AND user_id = private.current_app_user_id()
+    )
+  );
+
+DROP POLICY IF EXISTS bookings_select_owner_or_admin ON public.bookings;
+CREATE POLICY bookings_select_owner_or_admin ON public.bookings
+  FOR SELECT TO authenticated
+  USING (
+    private.is_admin()
+    OR (
+      private.current_app_user_role() = 'client'
+      AND user_id = private.current_app_user_id()
+    )
+  );
+
+-- `bookings_write_admin_only` and `booking_slots_write_admin_only` remain
+-- unchanged, including their server/admin-only writes. Booking-slot rows
+-- contain booking/user identifiers and are deliberately not exposed to lawyers.
+DROP POLICY IF EXISTS booking_slots_select_owner_or_admin ON public.booking_slots;
+CREATE POLICY booking_slots_select_owner_or_admin ON public.booking_slots
+  FOR SELECT TO authenticated
+  USING (
+    private.is_admin()
+    OR (
+      private.current_app_user_role() = 'client'
+      AND user_id = private.current_app_user_id()
+    )
+  );
+
+-- Lawyer access is restricted to read-only assigned cases/bookings. The
+-- relationship is `lawyers.user_id -> public.users.id`, not Auth UUID equality.
+CREATE OR REPLACE FUNCTION private.is_current_user_lawyer_for(p_lawyer_id text)
+RETURNS boolean
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = pg_catalog, public
+AS $function$
+  SELECT COALESCE(
+    auth.uid() IS NOT NULL
+    AND p_lawyer_id IS NOT NULL
+    AND private.current_app_user_role() = 'lawyer'
+    AND EXISTS (
+      SELECT 1
+      FROM public.lawyers AS l
+      WHERE l.id = p_lawyer_id
+        AND l.user_id = private.current_app_user_id()
+    ),
+    false
+  );
+$function$;
+REVOKE ALL ON FUNCTION private.is_current_user_lawyer_for(text) FROM PUBLIC, anon;
+GRANT EXECUTE ON FUNCTION private.is_current_user_lawyer_for(text) TO authenticated, service_role;
+
+DROP POLICY IF EXISTS cases_select_assigned_lawyer ON public.cases;
+CREATE POLICY cases_select_assigned_lawyer ON public.cases
+  FOR SELECT TO authenticated
+  USING (private.is_current_user_lawyer_for(lawyer_id));
+
+DROP POLICY IF EXISTS bookings_select_assigned_lawyer ON public.bookings;
+CREATE POLICY bookings_select_assigned_lawyer ON public.bookings
+  FOR SELECT TO authenticated
+  USING (private.is_current_user_lawyer_for(lawyer_id));
+
+COMMIT;
diff --git a/supabase/migrations/20261025142000_authenticated_transactional_rpcs.sql b/supabase/migrations/20261025142000_authenticated_transactional_rpcs.sql
new file mode 100644
index 0000000..6654069
--- /dev/null
+++ b/supabase/migrations/20261025142000_authenticated_transactional_rpcs.sql
@@ -0,0 +1,1719 @@
+-- =============================================================================
+-- Migration: 20261025142000_authenticated_transactional_rpcs.sql
+-- Purpose: replace service-only / compensating writes with authenticated,
+-- database-authorized, atomic RPCs for bookings, wallets, chats, cases, tasks,
+-- subscriptions, reviews, favorites, roles, and dashboard aggregates.
+--
+-- All SECURITY DEFINER functions pin search_path, derive identity from auth.uid,
+-- and check the authoritative public.users role. Provider-backed payment success
+-- is intentionally NOT implemented here.
+-- =============================================================================
+
+BEGIN;
+
+-- The old database cap (100,000) was lower than the route contract (1,000,000).
+-- Preflight without touching data so an unknown legacy row fails with a count
+-- before the check is replaced. Never clamp, round, or rewrite money values.
+DO $$
+DECLARE
+  v_invalid_amount_rows bigint;
+BEGIN
+  SELECT count(*) INTO v_invalid_amount_rows
+    FROM public.wallet_transactions
+   WHERE amount IS NULL OR amount <= 0 OR amount > 1000000;
+  IF v_invalid_amount_rows > 0 THEN
+    RAISE EXCEPTION 'Wallet amount preflight failed: % unsupported rows; no data was changed',
+      v_invalid_amount_rows;
+  END IF;
+END;
+$$;
+
+-- Keep all existing valid rows and make the constraint match the validated API.
+ALTER TABLE public.wallet_transactions
+  DROP CONSTRAINT IF EXISTS wallet_transactions_amount_check;
+ALTER TABLE public.wallet_transactions
+  ADD CONSTRAINT wallet_transactions_amount_check
+  CHECK (amount > 0 AND amount <= 1000000) NOT VALID;
+ALTER TABLE public.wallet_transactions
+  VALIDATE CONSTRAINT wallet_transactions_amount_check;
+
+-- Both booking and wallet idempotency must match the established Express
+-- contract: lowercase SHA-256 hex of UTF-8(owner) + NUL + UTF-8(trimmed key).
+-- The extension's installed schema varies between Supabase projects, so select
+-- only one of the two known pgcrypto locations at runtime; never interpolate a
+-- caller-controlled schema or function name.
+DO $$
+BEGIN
+  IF to_regprocedure('extensions.digest(bytea,text)') IS NULL
+     AND to_regprocedure('public.digest(bytea,text)') IS NULL THEN
+    RAISE EXCEPTION 'pgcrypto digest(bytea,text) is required for canonical idempotency hashes';
+  END IF;
+END;
+$$;
+
+CREATE OR REPLACE FUNCTION public._sha256_hex(p_value bytea)
+RETURNS text
+LANGUAGE plpgsql
+IMMUTABLE
+SECURITY INVOKER
+SET search_path = pg_catalog, public, pg_temp
+AS $$
+DECLARE
+  v_schema text;
+  v_hash text;
+BEGIN
+  IF p_value IS NULL THEN
+    RETURN NULL;
+  END IF;
+  IF to_regprocedure('extensions.digest(bytea,text)') IS NOT NULL THEN
+    v_schema := 'extensions';
+  ELSIF to_regprocedure('public.digest(bytea,text)') IS NOT NULL THEN
+    v_schema := 'public';
+  ELSE
+    RAISE EXCEPTION 'pgcrypto digest(bytea,text) is no longer available';
+  END IF;
+  EXECUTE format(
+    'SELECT pg_catalog.encode(%I.digest($1, ''sha256''), ''hex'')',
+    v_schema
+  ) INTO v_hash USING p_value;
+  RETURN v_hash;
+END;
+$$;
+
+-- Strict parser shared by booking RPCs. Returns NULL for malformed/invalid
+-- times; accepts HH:MM, 9:00 am, and 12-hour AM/PM strings used by the legacy UI.
+CREATE OR REPLACE FUNCTION public.clock_time_minutes(p_value text)
+RETURNS integer
+LANGUAGE plpgsql
+IMMUTABLE
+SET search_path = pg_catalog, public, pg_temp
+AS $$
+DECLARE
+  v_match text[];
+  v_hour integer;
+  v_minute integer;
+  v_suffix text;
+BEGIN
+  IF p_value IS NULL THEN
+    RETURN NULL;
+  END IF;
+  v_match := regexp_match(trim(p_value), '^([0-9]{1,2}):([0-9]{2})[[:space:]]*([AaPp][Mm])?$');
+  IF v_match IS NULL THEN
+    RETURN NULL;
+  END IF;
+
+  v_hour := v_match[1]::integer;
+  v_minute := v_match[2]::integer;
+  v_suffix := lower(v_match[3]);
+  IF v_minute < 0 OR v_minute > 59 THEN
+    RETURN NULL;
+  END IF;
+
+  IF v_suffix IS NOT NULL THEN
+    IF v_hour < 1 OR v_hour > 12 THEN
+      RETURN NULL;
+    END IF;
+    v_hour := v_hour % 12;
+    IF v_suffix = 'pm' THEN
+      v_hour := v_hour + 12;
+    END IF;
+  ELSIF v_hour < 0 OR v_hour > 23 THEN
+    RETURN NULL;
+  END IF;
+
+  RETURN v_hour * 60 + v_minute;
+END;
+$$;
+
+-- Internal slot writer. The unique (lawyer_id,date,slot) constraint is the
+-- concurrency arbiter; a conflict raises inside the caller's subtransaction,
+-- rolling back the booking and every slot inserted by that call.
+CREATE OR REPLACE FUNCTION public._reserve_booking_slots(
+  p_user_id text,
+  p_booking_id text,
+  p_lawyer_id text,
+  p_date text,
+  p_start_minute integer,
+  p_hours integer
+)
+RETURNS text[]
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog, public, pg_temp
+AS $$
+DECLARE
+  v_i integer;
+  v_slot integer;
+  v_id text;
+  v_ids text[] := ARRAY[]::text[];
+BEGIN
+  FOR v_i IN 0..p_hours - 1 LOOP
+    v_slot := p_start_minute + (v_i * 60);
+    v_id := gen_random_uuid()::text;
+    INSERT INTO public.booking_slots (id, lawyer_id, date, slot, booking_id, user_id)
+    VALUES (v_id, p_lawyer_id, p_date, v_slot, p_booking_id, p_user_id)
+    ON CONFLICT (lawyer_id, date, slot) DO NOTHING;
+
+    IF NOT FOUND THEN
+      RAISE EXCEPTION USING ERRCODE = 'P0001', MESSAGE = 'BOOKING_SLOT_TAKEN';
+    END IF;
+    v_ids := array_append(v_ids, v_id);
+  END LOOP;
+  RETURN v_ids;
+END;
+$$;
+
+-- Serialize booking operations and schedule edits for a lawyer/day. Advisory
+-- transaction locks cover the empty-row case; the availability trigger below
+-- ensures direct RLS/service-role INSERT/UPDATE/DELETE operations take the
+-- same lock before changing a published schedule.
+CREATE OR REPLACE FUNCTION public._lock_booking_day(
+  p_lawyer_id text,
+  p_date text
+)
+RETURNS void
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog, public, pg_temp
+AS $$
+BEGIN
+  IF p_lawyer_id IS NULL OR p_date IS NULL THEN
+    RETURN;
+  END IF;
+  PERFORM pg_advisory_xact_lock(
+    hashtextextended('booking-schedule:' || p_lawyer_id || ':' || p_date, 0)
+  );
+END;
+$$;
+
+CREATE OR REPLACE FUNCTION public.lock_schedule_change()
+RETURNS trigger
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog, public, pg_temp
+AS $$
+DECLARE
+  v_old_key text;
+  v_new_key text;
+BEGIN
+  IF TG_OP = 'INSERT' THEN
+    PERFORM public._lock_booking_day(NEW.lawyer_id, NEW.date);
+    RETURN NEW;
+  ELSIF TG_OP = 'DELETE' THEN
+    PERFORM public._lock_booking_day(OLD.lawyer_id, OLD.date);
+    RETURN OLD;
+  END IF;
+
+  v_old_key := COALESCE(OLD.lawyer_id, '') || '|' || COALESCE(OLD.date, '');
+  v_new_key := COALESCE(NEW.lawyer_id, '') || '|' || COALESCE(NEW.date, '');
+  IF v_old_key = v_new_key THEN
+    PERFORM public._lock_booking_day(NEW.lawyer_id, NEW.date);
+  ELSIF v_old_key < v_new_key THEN
+    PERFORM public._lock_booking_day(OLD.lawyer_id, OLD.date);
+    PERFORM public._lock_booking_day(NEW.lawyer_id, NEW.date);
+  ELSE
+    PERFORM public._lock_booking_day(NEW.lawyer_id, NEW.date);
+    PERFORM public._lock_booking_day(OLD.lawyer_id, OLD.date);
+  END IF;
+  RETURN NEW;
+END;
+$$;
+
+DROP TRIGGER IF EXISTS trg_availability_schedule_lock ON public.availability;
+CREATE TRIGGER trg_availability_schedule_lock
+  BEFORE INSERT OR UPDATE OF lawyer_id, date, slots OR DELETE ON public.availability
+  FOR EACH ROW
+  EXECUTE FUNCTION public.lock_schedule_change();
+
+-- Direct server-side booking mutations also take the same advisory locks. This
+-- does not make the legacy adapter's multi-request staged writes atomic; it
+-- only ensures each committed row change serializes with reservation RPCs.
+DROP TRIGGER IF EXISTS trg_bookings_schedule_lock ON public.bookings;
+CREATE TRIGGER trg_bookings_schedule_lock
+  BEFORE INSERT OR UPDATE OF lawyer_id, date, time, hours, status OR DELETE ON public.bookings
+  FOR EACH ROW
+  EXECUTE FUNCTION public.lock_schedule_change();
+
+-- Check existing appointment rows as a second line of defence for legacy data
+-- that predates booking_slots. Unknown legacy time/duration is a review blocker,
+-- not silently ignored; all non-Cancelled statuses (including Completed) reserve
+-- their historical interval, matching the existing Express booking contract.
+CREATE OR REPLACE FUNCTION public._booking_schedule_conflict(
+  p_lawyer_id text,
+  p_date text,
+  p_start_minute integer,
+  p_hours integer,
+  p_ignore_booking_id text DEFAULT NULL
+)
+RETURNS text
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog, public, pg_temp
+AS $$
+BEGIN
+  IF EXISTS (
+    SELECT 1
+      FROM public.bookings AS b
+     WHERE b.lawyer_id = p_lawyer_id
+       AND b.date = p_date
+       AND b.status <> 'Cancelled'
+       AND b.id IS DISTINCT FROM p_ignore_booking_id
+       AND (public.clock_time_minutes(b.time) IS NULL OR b.hours IS NULL OR b.hours <= 0)
+  ) THEN
+    RETURN 'LEGACY_BOOKING_REVIEW_REQUIRED';
+  END IF;
+
+  IF EXISTS (
+    SELECT 1
+      FROM public.bookings AS b
+     WHERE b.lawyer_id = p_lawyer_id
+       AND b.date = p_date
+       AND b.status <> 'Cancelled'
+       AND b.id IS DISTINCT FROM p_ignore_booking_id
+       AND public.clock_time_minutes(b.time) < p_start_minute + (p_hours * 60)
+       AND p_start_minute < public.clock_time_minutes(b.time) + (b.hours * 60)
+  ) THEN
+    RETURN 'BOOKING_OVERLAP';
+  END IF;
+
+  RETURN NULL;
+END;
+$$;
+
+-- Atomic client booking creation. Price/name/status/user are all database-
+-- derived; the client supplies only the lawyer, requested schedule, duration,
+-- and an optional idempotency key. No payment is implied by a booking.
+CREATE OR REPLACE FUNCTION public.rpc_create_booking(
+  p_lawyer_id text,
+  p_date text,
+  p_time text,
+  p_hours integer,
+  p_idempotency_key text DEFAULT NULL,
+  p_user_id text DEFAULT NULL
+)
+RETURNS jsonb
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog, public, pg_temp
+AS $$
+DECLARE
+  v_actor_id text := public.current_app_user_id();
+  v_user_id text;
+  v_start integer;
+  v_date date;
+  v_lawyer public.lawyers%ROWTYPE;
+  v_price numeric(12,2);
+  v_available integer[];
+  v_i integer;
+  v_lock_ids text[];
+  v_booking public.bookings%ROWTYPE;
+  v_existing public.bookings%ROWTYPE;
+  v_conflict text;
+  v_idempotency_key text := NULLIF(trim(p_idempotency_key), '');
+  v_idempotency_hash text;
+BEGIN
+  IF auth.uid() IS NULL OR v_actor_id IS NULL THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'AUTHENTICATION_REQUIRED';
+  END IF;
+  v_user_id := COALESCE(NULLIF(p_user_id, ''), v_actor_id);
+  IF v_user_id <> v_actor_id AND NOT public.is_admin() THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'NOT_BOOKING_OWNER';
+  END IF;
+  IF p_hours IS NULL OR p_hours < 1 OR p_hours > 12 THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_BOOKING_DURATION';
+  END IF;
+  IF v_idempotency_key IS NOT NULL AND char_length(v_idempotency_key) > 128 THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'IDEMPOTENCY_KEY_TOO_LONG';
+  END IF;
+  IF v_idempotency_key IS NOT NULL THEN
+    v_idempotency_hash := public._sha256_hex(
+      pg_catalog.convert_to(v_user_id, 'UTF8')
+      || pg_catalog.decode('00', 'hex')
+      || pg_catalog.convert_to(v_idempotency_key, 'UTF8')
+    );
+  END IF;
+
+  v_start := public.clock_time_minutes(p_time);
+  IF v_start IS NULL OR v_start + (p_hours * 60) > 1440 THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_BOOKING_TIME';
+  END IF;
+
+  BEGIN
+    v_date := p_date::date;
+  EXCEPTION WHEN OTHERS THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_BOOKING_DATE';
+  END;
+  IF to_char(v_date, 'YYYY-MM-DD') <> p_date THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_BOOKING_DATE';
+  END IF;
+
+  IF v_idempotency_hash IS NOT NULL THEN
+    SELECT * INTO v_existing
+      FROM public.bookings
+     WHERE user_id = v_user_id
+       AND idempotency_key_hash = v_idempotency_hash;
+    IF FOUND THEN
+      IF v_existing.lawyer_id <> p_lawyer_id
+         OR v_existing.date <> p_date
+         OR public.clock_time_minutes(v_existing.time) <> v_start
+         OR v_existing.hours <> p_hours THEN
+        RETURN jsonb_build_object('error', 'IDEMPOTENCY_KEY_MISMATCH');
+      END IF;
+      RETURN jsonb_build_object(
+        'replayed', true,
+        'booking', to_jsonb(v_existing) - 'idempotency_key_hash'
+      );
+    END IF;
+  END IF;
+
+  SELECT * INTO v_lawyer
+    FROM public.lawyers
+   WHERE id = p_lawyer_id;
+  IF NOT FOUND THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'LAWYER_NOT_FOUND';
+  END IF;
+  IF v_lawyer.price_value IS NULL OR v_lawyer.price_value < 0 THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'LAWYER_RATE_NOT_CONFIGURED';
+  END IF;
+  v_price := round(v_lawyer.price_value * p_hours, 2);
+
+  -- Serialize all booking and availability mutations for this lawyer/day,
+  -- including concurrent INSERT/DELETE when no schedule row existed yet.
+  PERFORM public._lock_booking_day(p_lawyer_id, p_date);
+  PERFORM a.id
+    FROM public.availability AS a
+   WHERE a.lawyer_id = p_lawyer_id
+     AND a.date = p_date
+   FOR SHARE;
+
+  -- Merge all published rows for this lawyer/date and normalize legacy 12/24h
+  -- clock strings. Every hourly interval must be advertised, not merely the
+  -- requested first slot.
+  SELECT array_agg(DISTINCT public.clock_time_minutes(slot_value))
+    INTO v_available
+    FROM public.availability AS a
+    CROSS JOIN LATERAL jsonb_array_elements_text(
+      CASE WHEN jsonb_typeof(a.slots) = 'array' THEN a.slots ELSE '[]'::jsonb END
+    ) AS slot_value
+   WHERE a.lawyer_id = p_lawyer_id
+     AND a.date = p_date
+     AND public.clock_time_minutes(slot_value) IS NOT NULL;
+  IF COALESCE(cardinality(v_available), 0) = 0 THEN
+    RETURN jsonb_build_object('error', 'NO_AVAILABILITY');
+  END IF;
+  FOR v_i IN 0..p_hours - 1 LOOP
+    IF NOT ((v_start + (v_i * 60)) = ANY(v_available)) THEN
+      RETURN jsonb_build_object('error', 'TIME_NOT_AVAILABLE');
+    END IF;
+  END LOOP;
+
+  v_conflict := public._booking_schedule_conflict(
+    p_lawyer_id, p_date, v_start, p_hours, NULL
+  );
+  IF v_conflict IS NOT NULL THEN
+    RETURN jsonb_build_object('error', v_conflict);
+  END IF;
+
+  BEGIN
+    INSERT INTO public.bookings (
+      user_id, lawyer_id, lawyer_name, date, time, hours, total_price,
+      status, slot_keys, idempotency_key_hash
+    ) VALUES (
+      v_user_id,
+      p_lawyer_id,
+      v_lawyer.name,
+      p_date,
+      to_char(make_time(v_start / 60, v_start % 60, 0), 'HH24:MI'),
+      p_hours,
+      v_price,
+      'Pending',
+      ARRAY[]::text[],
+      v_idempotency_hash
+    )
+    RETURNING * INTO v_booking;
+
+    v_lock_ids := public._reserve_booking_slots(
+      v_user_id, v_booking.id, p_lawyer_id, p_date, v_start, p_hours
+    );
+    UPDATE public.bookings
+       SET slot_keys = v_lock_ids,
+           updated_at = now()
+     WHERE id = v_booking.id
+     RETURNING * INTO v_booking;
+  EXCEPTION
+    WHEN unique_violation THEN
+      IF v_idempotency_hash IS NOT NULL THEN
+        SELECT * INTO v_existing
+          FROM public.bookings
+         WHERE user_id = v_user_id
+           AND idempotency_key_hash = v_idempotency_hash;
+        IF FOUND THEN
+          IF v_existing.lawyer_id = p_lawyer_id
+             AND v_existing.date = p_date
+             AND public.clock_time_minutes(v_existing.time) = v_start
+             AND v_existing.hours = p_hours THEN
+            RETURN jsonb_build_object(
+              'replayed', true,
+              'booking', to_jsonb(v_existing) - 'idempotency_key_hash'
+            );
+          END IF;
+          RETURN jsonb_build_object('error', 'IDEMPOTENCY_KEY_MISMATCH');
+        END IF;
+      END IF;
+      RETURN jsonb_build_object('error', 'SLOT_TAKEN');
+    WHEN SQLSTATE 'P0001' THEN
+      IF SQLERRM = 'BOOKING_SLOT_TAKEN' THEN
+        RETURN jsonb_build_object('error', 'SLOT_TAKEN');
+      END IF;
+      RAISE;
+  END;
+
+  RETURN jsonb_build_object(
+    'replayed', false,
+    'booking', to_jsonb(v_booking) - 'idempotency_key_hash'
+  );
+END;
+$$;
+
+-- Owner cancellation is terminal and releases every reserved slot atomically.
+CREATE OR REPLACE FUNCTION public.rpc_cancel_booking(p_booking_id text)
+RETURNS jsonb
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog, public, pg_temp
+AS $$
+DECLARE
+  v_user_id text := public.current_app_user_id();
+  v_booking public.bookings%ROWTYPE;
+BEGIN
+  IF auth.uid() IS NULL OR v_user_id IS NULL THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'AUTHENTICATION_REQUIRED';
+  END IF;
+  SELECT * INTO v_booking
+    FROM public.bookings
+   WHERE id = p_booking_id
+   FOR UPDATE;
+  IF NOT FOUND THEN
+    RAISE EXCEPTION USING ERRCODE = 'P0002', MESSAGE = 'BOOKING_NOT_FOUND';
+  END IF;
+  IF v_booking.user_id IS DISTINCT FROM v_user_id AND NOT public.is_admin() THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'NOT_BOOKING_OWNER';
+  END IF;
+  IF NOT public.is_admin() AND v_booking.status NOT IN ('Pending', 'Active') THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'BOOKING_CANNOT_BE_CANCELLED';
+  END IF;
+
+  DELETE FROM public.booking_slots WHERE booking_id = v_booking.id;
+  UPDATE public.bookings
+     SET status = 'Cancelled', slot_keys = ARRAY[]::text[], updated_at = now()
+   WHERE id = v_booking.id
+   RETURNING * INTO v_booking;
+  RETURN to_jsonb(v_booking) - 'idempotency_key_hash';
+END;
+$$;
+
+-- Admin-only status moderation. Direct table updates are not granted.
+CREATE OR REPLACE FUNCTION public.rpc_admin_set_booking_status(
+  p_booking_id text,
+  p_status text
+)
+RETURNS jsonb
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog, public, pg_temp
+AS $$
+DECLARE
+  v_booking public.bookings%ROWTYPE;
+BEGIN
+  IF NOT public.is_admin() THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'ADMIN_REQUIRED';
+  END IF;
+  IF p_status IS NULL OR p_status NOT IN ('Pending', 'Confirmed', 'Completed', 'Cancelled') THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_BOOKING_STATUS';
+  END IF;
+  SELECT * INTO v_booking FROM public.bookings WHERE id = p_booking_id FOR UPDATE;
+  IF NOT FOUND THEN
+    RAISE EXCEPTION USING ERRCODE = 'P0002', MESSAGE = 'BOOKING_NOT_FOUND';
+  END IF;
+  -- Cancelled bookings have released their slot locks, and completed
+  -- appointments are terminal. Reopening either state without a new reservation
+  -- would create a booking that does not actually own a schedule slot.
+  IF v_booking.status IN ('Cancelled', 'Completed') AND p_status <> v_booking.status THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'BOOKING_STATUS_IS_TERMINAL';
+  END IF;
+  IF p_status = 'Cancelled' THEN
+    DELETE FROM public.booking_slots WHERE booking_id = v_booking.id;
+  END IF;
+  UPDATE public.bookings
+     SET status = p_status,
+         slot_keys = CASE WHEN p_status = 'Cancelled' THEN ARRAY[]::text[] ELSE slot_keys END,
+         updated_at = now()
+   WHERE id = p_booking_id
+   RETURNING * INTO v_booking;
+  RETURN to_jsonb(v_booking) - 'idempotency_key_hash';
+END;
+$$;
+
+-- Admin rescheduling uses the same advertised-slot and unique-lock guarantees
+-- as creation. The old locks are restored automatically if the new schedule
+-- conflicts because the delete/reserve/update are one transaction.
+CREATE OR REPLACE FUNCTION public.rpc_admin_reschedule_booking(
+  p_booking_id text,
+  p_lawyer_id text,
+  p_date text,
+  p_time text,
+  p_hours integer
+)
+RETURNS jsonb
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog, public, pg_temp
+AS $$
+DECLARE
+  v_booking public.bookings%ROWTYPE;
+  v_lawyer public.lawyers%ROWTYPE;
+  v_start integer;
+  v_date date;
+  v_available integer[];
+  v_i integer;
+  v_lock_ids text[];
+  v_conflict text;
+BEGIN
+  IF NOT public.is_admin() THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'ADMIN_REQUIRED';
+  END IF;
+  IF p_hours IS NULL OR p_hours < 1 OR p_hours > 12 THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_BOOKING_DURATION';
+  END IF;
+  v_start := public.clock_time_minutes(p_time);
+  IF v_start IS NULL OR v_start + p_hours * 60 > 1440 THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_BOOKING_TIME';
+  END IF;
+  BEGIN
+    v_date := p_date::date;
+  EXCEPTION WHEN OTHERS THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_BOOKING_DATE';
+  END;
+  IF to_char(v_date, 'YYYY-MM-DD') <> p_date THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_BOOKING_DATE';
+  END IF;
+  SELECT * INTO v_booking FROM public.bookings WHERE id = p_booking_id FOR UPDATE;
+  IF NOT FOUND THEN
+    RAISE EXCEPTION USING ERRCODE = 'P0002', MESSAGE = 'BOOKING_NOT_FOUND';
+  END IF;
+  IF v_booking.status IN ('Cancelled', 'Completed') THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'TERMINAL_BOOKING_CANNOT_BE_RESCHEDULED';
+  END IF;
+  SELECT * INTO v_lawyer FROM public.lawyers WHERE id = p_lawyer_id;
+  IF NOT FOUND THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'LAWYER_NOT_FOUND';
+  END IF;
+
+  -- Acquire old/new schedule locks in a stable order, then hold the matching
+  -- availability rows while validating and reserving the rescheduled slots.
+  IF (COALESCE(v_booking.lawyer_id, '') || '|' || COALESCE(v_booking.date, ''))
+     <= (COALESCE(p_lawyer_id, '') || '|' || COALESCE(p_date, '')) THEN
+    PERFORM public._lock_booking_day(v_booking.lawyer_id, v_booking.date);
+    PERFORM public._lock_booking_day(p_lawyer_id, p_date);
+  ELSE
+    PERFORM public._lock_booking_day(p_lawyer_id, p_date);
+    PERFORM public._lock_booking_day(v_booking.lawyer_id, v_booking.date);
+  END IF;
+  PERFORM a.id
+    FROM public.availability AS a
+   WHERE a.lawyer_id = p_lawyer_id
+     AND a.date = p_date
+   FOR SHARE;
+
+  SELECT array_agg(DISTINCT public.clock_time_minutes(slot_value))
+    INTO v_available
+    FROM public.availability AS a
+    CROSS JOIN LATERAL jsonb_array_elements_text(
+      CASE WHEN jsonb_typeof(a.slots) = 'array' THEN a.slots ELSE '[]'::jsonb END
+    ) AS slot_value
+   WHERE a.lawyer_id = p_lawyer_id
+     AND a.date = p_date
+     AND public.clock_time_minutes(slot_value) IS NOT NULL;
+  IF COALESCE(cardinality(v_available), 0) = 0 THEN
+    RETURN jsonb_build_object('error', 'NO_AVAILABILITY');
+  END IF;
+  FOR v_i IN 0..p_hours - 1 LOOP
+    IF NOT ((v_start + (v_i * 60)) = ANY(v_available)) THEN
+      RETURN jsonb_build_object('error', 'TIME_NOT_AVAILABLE');
+    END IF;
+  END LOOP;
+
+  v_conflict := public._booking_schedule_conflict(
+    p_lawyer_id, p_date, v_start, p_hours, v_booking.id
+  );
+  IF v_conflict IS NOT NULL THEN
+    RETURN jsonb_build_object('error', v_conflict);
+  END IF;
+
+  BEGIN
+    DELETE FROM public.booking_slots WHERE booking_id = v_booking.id;
+    v_lock_ids := public._reserve_booking_slots(
+      v_booking.user_id, v_booking.id, p_lawyer_id, p_date, v_start, p_hours
+    );
+    UPDATE public.bookings
+       SET lawyer_id = p_lawyer_id,
+           lawyer_name = v_lawyer.name,
+           date = p_date,
+           time = to_char(make_time(v_start / 60, v_start % 60, 0), 'HH24:MI'),
+           hours = p_hours,
+           total_price = round(v_lawyer.price_value * p_hours, 2),
+           slot_keys = v_lock_ids,
+           updated_at = now()
+     WHERE id = v_booking.id
+     RETURNING * INTO v_booking;
+  EXCEPTION
+    WHEN unique_violation THEN
+      RETURN jsonb_build_object('error', 'SLOT_TAKEN');
+    WHEN SQLSTATE 'P0001' THEN
+      IF SQLERRM = 'BOOKING_SLOT_TAKEN' THEN
+        RETURN jsonb_build_object('error', 'SLOT_TAKEN');
+      END IF;
+      RAISE;
+  END;
+  RETURN to_jsonb(v_booking) - 'idempotency_key_hash';
+END;
+$$;
+
+-- Delete a booking and all of its held slots atomically. The existing route
+-- allows the booking owner or admin to delete; direct table/slot DML is revoked.
+CREATE OR REPLACE FUNCTION public.rpc_delete_booking(p_booking_id text)
+RETURNS jsonb
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog, public, pg_temp
+AS $$
+DECLARE
+  v_user_id text := public.current_app_user_id();
+  v_booking public.bookings%ROWTYPE;
+BEGIN
+  IF auth.uid() IS NULL OR v_user_id IS NULL THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'AUTHENTICATION_REQUIRED';
+  END IF;
+  SELECT * INTO v_booking
+    FROM public.bookings
+   WHERE id = p_booking_id
+   FOR UPDATE;
+  IF NOT FOUND THEN
+    RAISE EXCEPTION USING ERRCODE = 'P0002', MESSAGE = 'BOOKING_NOT_FOUND';
+  END IF;
+  IF v_booking.user_id IS DISTINCT FROM v_user_id AND NOT public.is_admin() THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'NOT_BOOKING_OWNER';
+  END IF;
+
+  DELETE FROM public.booking_slots WHERE booking_id = v_booking.id;
+  DELETE FROM public.bookings WHERE id = v_booking.id;
+  RETURN jsonb_build_object('id', v_booking.id);
+END;
+$$;
+
+-- Atomic wallet ledger. A non-admin may only debit their own wallet; an
+-- authenticated database admin may make the same manual credits/debits as the
+-- existing Admin API. Client payment-provider credits are still unavailable:
+-- no caller-supplied value is treated as proof of payment or a webhook result.
+CREATE OR REPLACE FUNCTION public.rpc_wallet_mutate(
+  p_user_id text,
+  p_type text,
+  p_amount numeric,
+  p_description text,
+  p_idempotency_id text DEFAULT NULL
+)
+RETURNS jsonb
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog, public, pg_temp
+AS $$
+DECLARE
+  v_actor text := public.current_app_user_id();
+  v_idem_id text;
+  v_idempotency_key text := NULLIF(trim(p_idempotency_id), '');
+  v_idem public.wallet_idempotency%ROWTYPE;
+  v_wallet public.wallets%ROWTYPE;
+  v_next_balance numeric(14,2);
+  v_tx public.wallet_transactions%ROWTYPE;
+BEGIN
+  IF p_user_id IS NULL OR p_type IS NULL OR p_type NOT IN ('credit', 'debit')
+     OR p_amount IS NULL OR p_amount <= 0 OR p_amount > 1000000
+     OR p_amount <> round(p_amount, 2) THEN
+    RETURN jsonb_build_object('error', 'INVALID_TRANSACTION');
+  END IF;
+  IF auth.uid() IS NULL OR v_actor IS NULL THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'AUTHENTICATION_REQUIRED';
+  END IF;
+  IF NOT public.is_admin()
+     AND (p_type <> 'debit' OR p_user_id <> v_actor) THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'WALLET_OPERATION_NOT_AUTHORIZED';
+  END IF;
+  IF NOT EXISTS (SELECT 1 FROM public.users WHERE id = p_user_id) THEN
+    RETURN jsonb_build_object('error', 'UNKNOWN_USER');
+  END IF;
+
+  IF v_idempotency_key IS NOT NULL THEN
+    IF char_length(v_idempotency_key) > 128 THEN
+      RETURN jsonb_build_object('error', 'IDEMPOTENCY_KEY_TOO_LONG');
+    END IF;
+    -- Match Express exactly: SHA-256(owner UTF-8 + NUL + trimmed key UTF-8).
+    -- Only the digest is persisted; no raw key or delimiter-ambiguous composite.
+    v_idem_id := public._sha256_hex(
+      pg_catalog.convert_to(p_user_id, 'UTF8')
+      || pg_catalog.decode('00', 'hex')
+      || pg_catalog.convert_to(v_idempotency_key, 'UTF8')
+    );
+    -- Serialize retries with the same digest before checking/inserting the
+    -- ledger record so concurrent requests replay instead of returning 500.
+    PERFORM pg_advisory_xact_lock(hashtextextended(v_idem_id, 0));
+  END IF;
+
+  INSERT INTO public.wallets (id, user_id, balance, currency)
+  VALUES (p_user_id, p_user_id, 0, 'USD')
+  ON CONFLICT (id) DO NOTHING;
+  SELECT * INTO v_wallet FROM public.wallets WHERE id = p_user_id FOR UPDATE;
+  IF v_wallet.currency <> 'USD' THEN
+    RETURN jsonb_build_object('error', 'CURRENCY_MISMATCH', 'currency', v_wallet.currency);
+  END IF;
+
+  IF v_idem_id IS NOT NULL THEN
+    SELECT * INTO v_idem FROM public.wallet_idempotency WHERE id = v_idem_id FOR UPDATE;
+    IF FOUND THEN
+      IF v_idem.user_id <> p_user_id OR v_idem.type <> p_type OR v_idem.amount <> p_amount THEN
+        RETURN jsonb_build_object('error', 'IDEMPOTENCY_KEY_MISMATCH');
+      END IF;
+      RETURN jsonb_build_object(
+        'replayed', true,
+        'balance', v_idem.balance,
+        'currency', v_idem.currency,
+        'transaction', v_idem.transaction - 'idempotency_key_hash'
+      );
+    END IF;
+  END IF;
+
+  IF p_type = 'debit' AND v_wallet.balance < p_amount THEN
+    RETURN jsonb_build_object('error', 'INSUFFICIENT_FUNDS', 'available', v_wallet.balance);
+  END IF;
+  v_next_balance := CASE
+    WHEN p_type = 'debit' THEN v_wallet.balance - p_amount
+    ELSE v_wallet.balance + p_amount
+  END;
+
+  UPDATE public.wallets
+     SET balance = v_next_balance, updated_at = now()
+   WHERE id = p_user_id
+   RETURNING * INTO v_wallet;
+  INSERT INTO public.wallet_transactions (
+    user_id, type, amount, description, balance, currency, idempotency_key_hash
+  ) VALUES (
+    p_user_id, p_type, p_amount, left(COALESCE(p_description, ''), 300), v_next_balance,
+    v_wallet.currency, v_idem_id
+  ) RETURNING * INTO v_tx;
+
+  IF v_idem_id IS NOT NULL THEN
+    INSERT INTO public.wallet_idempotency (
+      id, user_id, type, amount, currency, balance, transaction
+    ) VALUES (
+      v_idem_id, p_user_id, p_type, p_amount, v_wallet.currency, v_next_balance,
+      to_jsonb(v_tx)
+    );
+  END IF;
+  RETURN jsonb_build_object(
+    'replayed', false,
+    'balance', v_next_balance,
+    'currency', v_wallet.currency,
+    'transaction', to_jsonb(v_tx) - 'idempotency_key_hash'
+  );
+END;
+$$;
+
+-- Chat creation and message append are one database transaction. Names and
+-- sender identity come from public.users, never from client-supplied metadata.
+CREATE OR REPLACE FUNCTION public.rpc_chat_create(
+  p_participants text[],
+  p_initial_message text DEFAULT NULL
+)
+RETURNS jsonb
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog, public, pg_temp
+AS $$
+DECLARE
+  v_actor text := public.current_app_user_id();
+  v_participants text[];
+  v_names jsonb;
+  v_chat public.chats%ROWTYPE;
+  v_message public.chat_messages%ROWTYPE;
+  v_text text := NULLIF(trim(p_initial_message), '');
+  v_name text;
+BEGIN
+  IF auth.uid() IS NULL OR v_actor IS NULL THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'AUTHENTICATION_REQUIRED';
+  END IF;
+  SELECT array_agg(x ORDER BY x) INTO v_participants
+    FROM (SELECT DISTINCT trim(value) AS x
+            FROM unnest(COALESCE(p_participants, ARRAY[]::text[])) AS value
+           WHERE trim(value) <> '') AS unique_values;
+  IF COALESCE(cardinality(v_participants), 0) < 2 THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'TWO_DISTINCT_PARTICIPANTS_REQUIRED';
+  END IF;
+  IF NOT public.is_admin() AND NOT (v_actor = ANY(v_participants)) THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'CALLER_MUST_BE_PARTICIPANT';
+  END IF;
+  IF (SELECT count(*) FROM public.users WHERE id = ANY(v_participants)) <> cardinality(v_participants) THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'UNKNOWN_CHAT_PARTICIPANT';
+  END IF;
+
+  SELECT jsonb_object_agg(id, name) INTO v_names
+    FROM public.users WHERE id = ANY(v_participants);
+  INSERT INTO public.chats (participants, participant_names, last_message)
+  VALUES (v_participants, COALESCE(v_names, '{}'::jsonb), COALESCE(v_text, ''))
+  RETURNING * INTO v_chat;
+
+  IF v_text IS NOT NULL THEN
+    IF char_length(v_text) > 4000 THEN
+      RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'MESSAGE_TOO_LONG';
+    END IF;
+    SELECT name INTO v_name FROM public.users WHERE id = v_actor;
+    INSERT INTO public.chat_messages (chat_id, sender_id, sender_name, text)
+    VALUES (v_chat.id, v_actor, COALESCE(NULLIF(trim(v_name), ''), 'User'), v_text)
+    RETURNING * INTO v_message;
+    UPDATE public.chats SET last_message = v_text, updated_at = now()
+     WHERE id = v_chat.id RETURNING * INTO v_chat;
+  END IF;
+
+  RETURN jsonb_build_object(
+    'chat', to_jsonb(v_chat),
+    'message', CASE WHEN v_text IS NULL THEN NULL ELSE to_jsonb(v_message) END
+  );
+END;
+$$;
+
+CREATE OR REPLACE FUNCTION public.rpc_chat_send_message(
+  p_chat_id text,
+  p_text text
+)
+RETURNS jsonb
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog, public, pg_temp
+AS $$
+DECLARE
+  v_actor text := public.current_app_user_id();
+  v_chat public.chats%ROWTYPE;
+  v_message public.chat_messages%ROWTYPE;
+  v_name text;
+  v_text text := trim(COALESCE(p_text, ''));
+BEGIN
+  IF auth.uid() IS NULL OR v_actor IS NULL THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'AUTHENTICATION_REQUIRED';
+  END IF;
+  IF v_text = '' OR char_length(v_text) > 4000 THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_MESSAGE';
+  END IF;
+  SELECT * INTO v_chat FROM public.chats WHERE id = p_chat_id FOR UPDATE;
+  IF NOT FOUND THEN
+    RAISE EXCEPTION USING ERRCODE = 'P0002', MESSAGE = 'CHAT_NOT_FOUND';
+  END IF;
+  IF NOT public.is_admin() AND NOT (v_actor = ANY(v_chat.participants)) THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'NOT_CHAT_PARTICIPANT';
+  END IF;
+  SELECT name INTO v_name FROM public.users WHERE id = v_actor;
+  INSERT INTO public.chat_messages (chat_id, sender_id, sender_name, text)
+  VALUES (v_chat.id, v_actor, COALESCE(NULLIF(trim(v_name), ''), 'User'), v_text)
+  RETURNING * INTO v_message;
+  UPDATE public.chats
+     SET last_message = v_text, updated_at = now()
+   WHERE id = v_chat.id;
+  RETURN to_jsonb(v_message);
+END;
+$$;
+
+-- Case/task transitions are authenticated, owner/admin checked, and keep status
+-- values inside the contract. Case owners have no general status column grant.
+CREATE OR REPLACE FUNCTION public.rpc_case_set_status(p_case_id text, p_status text)
+RETURNS jsonb
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog, public, pg_temp
+AS $$
+DECLARE
+  v_actor text := public.current_app_user_id();
+  v_case public.cases%ROWTYPE;
+BEGIN
+  IF auth.uid() IS NULL OR v_actor IS NULL THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'AUTHENTICATION_REQUIRED';
+  END IF;
+  IF p_status IS NULL OR p_status NOT IN ('Open', 'In Progress', 'Closed', 'Pending') THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_CASE_STATUS';
+  END IF;
+  SELECT * INTO v_case FROM public.cases WHERE id = p_case_id FOR UPDATE;
+  IF NOT FOUND THEN
+    RAISE EXCEPTION USING ERRCODE = 'P0002', MESSAGE = 'CASE_NOT_FOUND';
+  END IF;
+  IF NOT public.is_admin()
+     AND (public.current_app_user_role() <> 'client'
+       OR v_case.user_id IS DISTINCT FROM v_actor) THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'NOT_CASE_OWNER';
+  END IF;
+  UPDATE public.cases SET status = p_status, updated_at = now()
+   WHERE id = p_case_id RETURNING * INTO v_case;
+  RETURN to_jsonb(v_case);
+END;
+$$;
+
+-- Atomically update case content, status, and (admin-only) ownership. The table
+-- has no case_id relation in the observed schema, so this RPC does not invent one.
+CREATE OR REPLACE FUNCTION public.rpc_case_update(
+  p_case_id text,
+  p_changes jsonb
+)
+RETURNS jsonb
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog, public, pg_temp
+AS $$
+DECLARE
+  v_actor text := public.current_app_user_id();
+  v_case public.cases%ROWTYPE;
+  v_key text;
+  v_owner text;
+BEGIN
+  IF auth.uid() IS NULL OR v_actor IS NULL THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'AUTHENTICATION_REQUIRED';
+  END IF;
+  IF p_changes IS NULL OR jsonb_typeof(p_changes) <> 'object'
+     OR p_changes = '{}'::jsonb THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_CASE_PATCH';
+  END IF;
+  FOR v_key IN SELECT jsonb_object_keys(p_changes) LOOP
+    IF v_key NOT IN ('title', 'description', 'client_name', 'case_type', 'priority', 'due_date', 'status', 'user_id') THEN
+      RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_CASE_FIELD';
+    END IF;
+  END LOOP;
+
+  SELECT * INTO v_case FROM public.cases WHERE id = p_case_id FOR UPDATE;
+  IF NOT FOUND THEN
+    RAISE EXCEPTION USING ERRCODE = 'P0002', MESSAGE = 'CASE_NOT_FOUND';
+  END IF;
+  IF NOT public.is_admin()
+     AND (public.current_app_user_role() <> 'client'
+       OR v_case.user_id IS DISTINCT FROM v_actor) THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'NOT_CASE_OWNER';
+  END IF;
+
+  IF p_changes ? 'title'
+     AND (jsonb_typeof(p_changes->'title') <> 'string'
+       OR char_length(trim(p_changes->>'title')) < 2
+       OR char_length(p_changes->>'title') > 200) THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_CASE_TITLE';
+  END IF;
+  IF p_changes ? 'description'
+     AND jsonb_typeof(p_changes->'description') NOT IN ('string', 'null') THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_CASE_DESCRIPTION';
+  END IF;
+  IF p_changes ? 'description' AND char_length(COALESCE(p_changes->>'description', '')) > 4000 THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_CASE_DESCRIPTION';
+  END IF;
+  IF p_changes ? 'client_name'
+     AND (jsonb_typeof(p_changes->'client_name') NOT IN ('string', 'null')
+       OR char_length(COALESCE(p_changes->>'client_name', '')) > 160) THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_CASE_CLIENT_NAME';
+  END IF;
+  IF p_changes ? 'case_type'
+     AND (jsonb_typeof(p_changes->'case_type') NOT IN ('string', 'null')
+       OR char_length(COALESCE(p_changes->>'case_type', '')) > 120) THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_CASE_TYPE';
+  END IF;
+  IF p_changes ? 'priority'
+     AND (jsonb_typeof(p_changes->'priority') <> 'string'
+       OR p_changes->>'priority' NOT IN ('High', 'Medium', 'Low')) THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_CASE_PRIORITY';
+  END IF;
+  IF p_changes ? 'status'
+     AND (jsonb_typeof(p_changes->'status') <> 'string'
+       OR p_changes->>'status' NOT IN ('Open', 'In Progress', 'Closed', 'Pending')) THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_CASE_STATUS';
+  END IF;
+  IF p_changes ? 'due_date'
+     AND jsonb_typeof(p_changes->'due_date') NOT IN ('string', 'null') THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_CASE_DUE_DATE';
+  END IF;
+  IF p_changes ? 'user_id' THEN
+    IF NOT public.is_admin() THEN
+      IF p_changes->>'user_id' IS DISTINCT FROM v_case.user_id THEN
+        RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'ADMIN_REQUIRED_FOR_CASE_REASSIGNMENT';
+      END IF;
+    ELSE
+      v_owner := NULLIF(p_changes->>'user_id', '');
+      IF v_owner IS NULL OR NOT public.is_eligible_case_owner(v_owner) THEN
+        RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INELIGIBLE_CASE_OWNER';
+      END IF;
+    END IF;
+  END IF;
+
+  UPDATE public.cases
+     SET title = CASE WHEN p_changes ? 'title' THEN p_changes->>'title' ELSE title END,
+         description = CASE WHEN p_changes ? 'description'
+                             THEN COALESCE(p_changes->>'description', '') ELSE description END,
+         client_name = CASE WHEN p_changes ? 'client_name'
+                            THEN COALESCE(p_changes->>'client_name', '') ELSE client_name END,
+         case_type = CASE WHEN p_changes ? 'case_type'
+                          THEN COALESCE(p_changes->>'case_type', '') ELSE case_type END,
+         priority = CASE WHEN p_changes ? 'priority' THEN p_changes->>'priority' ELSE priority END,
+         status = CASE WHEN p_changes ? 'status' THEN p_changes->>'status' ELSE status END,
+         due_date = CASE WHEN p_changes ? 'due_date'
+                         THEN COALESCE(p_changes->>'due_date', '') ELSE due_date END,
+         user_id = CASE WHEN public.is_admin() AND p_changes ? 'user_id'
+                        THEN v_owner ELSE user_id END,
+         updated_at = now()
+   WHERE id = p_case_id RETURNING * INTO v_case;
+  RETURN to_jsonb(v_case);
+END;
+$$;
+
+CREATE OR REPLACE FUNCTION public.rpc_task_set_status(p_task_id text, p_status text)
+RETURNS jsonb
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog, public, pg_temp
+AS $$
+DECLARE
+  v_actor text := public.current_app_user_id();
+  v_task public.tasks%ROWTYPE;
+  v_allowed text[];
+BEGIN
+  IF auth.uid() IS NULL OR v_actor IS NULL THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'AUTHENTICATION_REQUIRED';
+  END IF;
+  IF p_status IS NULL OR p_status NOT IN ('Pending', 'In Progress', 'Completed', 'Cancelled') THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_TASK_STATUS';
+  END IF;
+  SELECT * INTO v_task FROM public.tasks WHERE id = p_task_id FOR UPDATE;
+  IF NOT FOUND THEN
+    RAISE EXCEPTION USING ERRCODE = 'P0002', MESSAGE = 'TASK_NOT_FOUND';
+  END IF;
+  IF v_task.user_id IS DISTINCT FROM v_actor AND NOT public.is_admin() THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'NOT_TASK_OWNER';
+  END IF;
+  IF NOT public.is_admin() THEN
+    v_allowed := CASE v_task.status
+      WHEN 'Pending' THEN ARRAY['In Progress', 'Completed', 'Cancelled']::text[]
+      WHEN 'To Do' THEN ARRAY['Pending', 'In Progress', 'Completed', 'Cancelled']::text[]
+      WHEN 'In Progress' THEN ARRAY['Completed', 'Cancelled']::text[]
+      -- Legacy Done/Completed/Cancelled rows are terminal for non-admins.
+      -- An administrator can correct a legacy row through the checked branch.
+      ELSE ARRAY[]::text[]
+    END;
+    IF NOT (p_status = ANY(v_allowed)) THEN
+      RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'INVALID_TASK_TRANSITION';
+    END IF;
+  END IF;
+  UPDATE public.tasks SET status = p_status, updated_at = now()
+   WHERE id = p_task_id RETURNING * INTO v_task;
+  RETURN to_jsonb(v_task);
+END;
+$$;
+
+-- General task edits and status transitions share one row lock and transaction;
+-- the client never receives a direct UPDATE grant on the protected status field.
+CREATE OR REPLACE FUNCTION public.rpc_task_update(
+  p_task_id text,
+  p_changes jsonb
+)
+RETURNS jsonb
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog, public, pg_temp
+AS $$
+DECLARE
+  v_actor text := public.current_app_user_id();
+  v_task public.tasks%ROWTYPE;
+  v_key text;
+  v_allowed text[];
+  v_status text;
+BEGIN
+  IF auth.uid() IS NULL OR v_actor IS NULL THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'AUTHENTICATION_REQUIRED';
+  END IF;
+  IF p_changes IS NULL OR jsonb_typeof(p_changes) <> 'object'
+     OR p_changes = '{}'::jsonb THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_TASK_PATCH';
+  END IF;
+  FOR v_key IN SELECT jsonb_object_keys(p_changes) LOOP
+    IF v_key NOT IN ('title', 'description', 'due_date', 'priority', 'status') THEN
+      RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_TASK_FIELD';
+    END IF;
+  END LOOP;
+
+  SELECT * INTO v_task FROM public.tasks WHERE id = p_task_id FOR UPDATE;
+  IF NOT FOUND THEN
+    RAISE EXCEPTION USING ERRCODE = 'P0002', MESSAGE = 'TASK_NOT_FOUND';
+  END IF;
+  IF v_task.user_id IS DISTINCT FROM v_actor AND NOT public.is_admin() THEN
+    RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'NOT_TASK_OWNER';
+  END IF;
+
+  IF p_changes ? 'title'
+     AND (jsonb_typeof(p_changes->'title') <> 'string'
+       OR char_length(trim(p_changes->>'title')) < 2
+       OR char_length(p_changes->>'title') > 200) THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_TASK_TITLE';
+  END IF;
+  IF p_changes ? 'description'
+     AND jsonb_typeof(p_changes->'description') NOT IN ('string', 'null') THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_TASK_DESCRIPTION';
+  END IF;
+  IF p_changes ? 'description' AND char_length(COALESCE(p_changes->>'description', '')) > 4000 THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_TASK_DESCRIPTION';
+  END IF;
+  IF p_changes ? 'due_date'
+     AND jsonb_typeof(p_changes->'due_date') NOT IN ('string', 'null') THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_TASK_DUE_DATE';
+  END IF;
+  IF p_changes ? 'priority'
+     AND (jsonb_typeof(p_changes->'priority') <> 'string'
+       OR p_changes->>'priority' NOT IN ('High', 'Medium', 'Low')) THEN
+    RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_TASK_PRIORITY';
+  END IF;
+
+  IF p_changes ? 'status' THEN
+    v_status := p_changes->>'status';
+    IF jsonb_typeof(p_changes->'status') <> 'string'
+       OR v_status NOT IN ('Pending', 'In Progress', 'Completed', 'Cancelled') THEN
+      RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'INVALID_TASK_STATUS';
+    END IF;
+    IF NOT public.is_admin() AND v_status IS DISTINCT FROM v_task.status THEN
+      v_allowed := CASE v_task.status
+        WHEN 'Pending' THEN ARRAY['In Progress', 'Completed', 'Cancelled']::text[]
+        WHEN 'To Do' THEN ARRAY['Pending', 'In Progress', 'Completed', 'Cancelled']::text[]
+        WHEN 'In Progress' THEN ARRAY['Completed', 'Cancelled']::text[]
+        ELSE ARRAY[]::text[]
+      END;
+      IF NOT (v_status = ANY(v_allowed)) THEN
+        RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'INVALID_TASK_TRANSITION';
+      END IF;
+    END IF;
+  END IF;
+
+  UPDATE public.tasks
+     SET title = CASE WHEN p_changes ? 'title' THEN p_changes->>'title' ELSE title END,
+         description = CASE WHEN p_changes ? 'description'
+                            THEN COALESCE(p_changes->>'description', '') ELSE description END,
+         due_date = CASE WHEN p_changes ? 'due_date'
+                         THEN COALESCE(p_changes->>'due_date', '') ELSE due_date END,
+         priority = CASE WHEN p_changes ? 'priority' THEN p_changes->>'priority' ELSE priority END,
+         status = CASE WHEN p_changes ? 'status' THEN p_changes->>'status' ELSE status END,
+         updated_at = now()
+   WHERE id = p_task_id RETURNING * INTO v_task;
+  RETURN to_jsonb(v_task);
+END;
+$$;
