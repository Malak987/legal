# =====================================================
# Legal Services App - Backend Configuration
# Copy this file to ".env" and fill in your values.
# =====================================================

# --- Server ---
PORT=5000
NODE_ENV=development
# Comma separated list of allowed origins (your Flutter Web admin URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- Firebase (Admin SDK) ---
# Path to the service account JSON you downloaded from Firebase Console
#   Firebase Console > Project Settings > Service accounts > Generate new private key
SERVICE_ACCOUNT_PATH=./serviceAccount.json

# --- Firebase Auth ---
# Issuer used to validate ID tokens (usually https://securetoken.google.com/<project-id>)
# Leave empty to auto-detect from the service account.
FIREBASE_PROJECT_ID=

# --- Security ---
# Secret used to sign internal admin sessions (optional, for the seed admin user)
ADMIN_JWT_SECRET=change-this-to-a-long-random-secret

# --- Optional: Seed data on first run ---
SEED_ON_START=true
