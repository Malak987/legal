# =====================================================
# Legal Services App - Standalone Local Backend Config
# =====================================================
# NOTE: Production runs on Firebase Cloud Functions (Gen 2) with managed
# Google Cloud credentials and does NOT read `backend/.env` or require
# `serviceAccount.json` (see `backend/functions-config/.env.example`).
#
# Copy this file to `backend/.env` ONLY if running standalone `npm run dev`
# outside Firebase Cloud Functions / Firebase Emulator Suite.

# --- Local Standalone Server ---
PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,https://legal-102026.web.app,https://legal-102026.firebaseapp.com

# --- Local Firebase Admin Credentials (not used in Cloud Functions) ---
SERVICE_ACCOUNT_PATH=./serviceAccount.json
FIREBASE_PROJECT_ID=legal-102026

# --- Seed Safeguard (NEVER enable against production) ---
SEED_ON_START=false
SEED_ADMIN_PASSWORD=
SEED_CLIENT_PASSWORD=
SEED_LAWYER_PASSWORD=
