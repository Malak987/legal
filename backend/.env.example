# =====================================================
# Legal Services App - Backend Configuration
# Copy this file to ".env" and fill in your values.
# =====================================================

# --- Server ---
PORT=5000
NODE_ENV=development
# Comma separated list of allowed origins (your Flutter Web admin URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- Firebase (Admin SDK) ---
# Path to the service account JSON you downloaded from Firebase Console
#   Firebase Console > Project Settings > Service accounts > Generate new private key
SERVICE_ACCOUNT_PATH=./serviceAccount.json

# --- Firebase Auth ---
# Issuer used to validate ID tokens (usually https://securetoken.google.com/<project-id>)
# Leave empty to auto-detect from the service account.
FIREBASE_PROJECT_ID=

# --- Security ---
# Secret used to sign internal admin sessions (optional, for the seed admin user)
ADMIN_JWT_SECRET=change-this-to-a-long-random-secret

# --- Optional: Seed data on first run ---
# WARNING: keep this `false`. When true, backend/src/index.js runs seed.js on
# EVERY server start. seed.js is not idempotent: 9 collections are written with
# random document ids (lawyers, plans, cases, bookings, tasks, reviews,
# notifications, availability, favorites) plus chat messages and wallet
# transactions, so every start ADDS another full copy. It also creates demo
# auth accounts with fixed uids and known passwords.
# Unset/anything other than "true" means no seeding, which is the safe default.
SEED_ON_START=false

# Seed credentials (required only when running `npm run seed` or SEED_ON_START=true).
# The seed creates real accounts, so it refuses to run if these are empty.
# Choose your own values; never commit them. 12 characters minimum.
SEED_ADMIN_PASSWORD=
SEED_CLIENT_PASSWORD=
SEED_LAWYER_PASSWORD=
