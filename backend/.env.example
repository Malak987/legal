# Supabase-backed Legal Services API configuration.
# Copy to `backend/.env`; never commit real keys or service-role credentials.

PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Server-side Supabase connection. SUPABASE_SERVICE_ROLE_KEY must never be
# placed in Flutter code, browser bundles, or public configuration.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public lawyer signup is closed by default. Enabling requires an approved,
# allow-listed redirect and the reviewed identity SQL; this example stays off.
ENABLE_LAWYER_SIGNUP=false
LAWYER_SIGNUP_REDIRECT_URL=

# Optional local-only synthetic test seed. It refuses non-loopback URLs and
# production mode; these variables are not part of the normal API runtime.
LEGAL_ALLOW_TEST_SEED=false
SUPABASE_TEST_URL=http://127.0.0.1:54321
SUPABASE_TEST_SERVICE_ROLE_KEY=
