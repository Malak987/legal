# =====================================================
# Legal Services App - Backend Configuration
# =====================================================
# Copy this file to `backend/.env` when running standalone (`npm run dev` / `npm start`).
# Never commit `backend/.env` or any secret/service-role keys.

# --- Server ---
PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,https://legal-102026.web.app,https://legal-102026.firebaseapp.com

# --- Primary Backend: Supabase PostgreSQL + Supabase Auth ---
# Keep SUPABASE_SERVICE_ROLE_KEY strictly on the server; never expose it in
# Flutter, web bundles, or public configuration.
SUPABASE_PROJECT_REF=qqfzbecwhewswkyxgebu
SUPABASE_URL=https://qqfzbecwhewswkyxgebu.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Legacy Firebase Fallback (only used if SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are unset) ---
SERVICE_ACCOUNT_PATH=./serviceAccount.json
FIREBASE_PROJECT_ID=legal-102026

# --- Seed Safeguard (NEVER enable against production) ---
SEED_ON_START=false
SEED_ADMIN_PASSWORD=
SEED_CLIENT_PASSWORD=
SEED_LAWYER_PASSWORD=
