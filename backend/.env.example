# Legal Services API — local development configuration.
# Copy to `backend/.env`; never commit that file, service-account JSON, or keys.

# --- Server ---
PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- Primary backend: Supabase PostgreSQL + Auth ---
SUPABASE_PROJECT_REF=qqfzbecwhewswkyxgebu
SUPABASE_URL=https://qqfzbecwhewswkyxgebu.supabase.co
SUPABASE_ANON_KEY=
# Server-only credential: configure locally outside version control or bind as
# a Firebase Secret in Cloud Functions. Never put this key in Flutter/web code.
SUPABASE_SERVICE_ROLE_KEY=
# Optional alias for a Supabase `sb_secret_...` server credential.
SUPABASE_SECRET_KEY=
SUPABASE_AUTH_REDIRECT_URL=

# --- Legacy Firebase Admin compatibility ---
# Cloud Functions uses managed credentials. For local Firebase emulator work,
# use the emulator suite; standalone service-account JSON must remain untracked.
FIREBASE_PROJECT_ID=legal-102026
SERVICE_ACCOUNT_PATH=./serviceAccount.json

# Public lawyer signup remains closed unless separately approved and allow-listed.
ENABLE_LAWYER_SIGNUP=false
LAWYER_SIGNUP_REDIRECT_URL=

# Synthetic integration seed: loopback-only, explicitly opt-in, never production.
LEGAL_ALLOW_TEST_SEED=false
SUPABASE_TEST_URL=http://127.0.0.1:54321
SUPABASE_TEST_SERVICE_ROLE_KEY=
