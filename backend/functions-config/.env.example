# =====================================================
# Supabase-backed Cloud Runtime Configuration
# =====================================================
# Required by Supabase-backed API routes. Configure the public values through
# runtime environment variables and the service-role credential as a Firebase Secret:
#
# SUPABASE_PROJECT_REF=qqfzbecwhewswkyxgebu
# SUPABASE_URL=https://qqfzbecwhewswkyxgebu.supabase.co
# SUPABASE_ANON_KEY=<public-anon-or-publishable-key>
# Bind SUPABASE_SERVICE_ROLE_KEY as a Firebase Secret; backend/index.js declares
# the secret binding and the value must never be committed or sent to Flutter.
# SUPABASE_SERVICE_ROLE_KEY=<set separately in Firebase Secret Manager>
#
# Lawyer signup stays disabled unless an approved callback is allow-listed in
# Supabase Auth and the identity migration is separately approved/deployed:
# ENABLE_LAWYER_SIGNUP=false
# LAWYER_SIGNUP_REDIRECT_URL=
#
# Optional custom CORS origins:
# CORS_ORIGINS=https://legal-102026.web.app,https://legal-102026.firebaseapp.com,https://your-custom-domain.example.com
