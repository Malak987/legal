+  String _postgrestSearchTerm(String value) {
+    var safe = value.trim();
+    for (final character in <String>[
+      ',',
+      '(',
+      ')',
+      '"',
+      "'",
+      String.fromCharCode(92),
+      '*',
+      '%',
+      '_',
+    ]) {
+      safe = safe.replaceAll(character, ' ');
+    }
+    return safe.replaceAll(RegExp(r'\s+'), ' ').trim();
+  }
