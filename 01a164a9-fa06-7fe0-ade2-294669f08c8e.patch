+      process.env.LAWYER_SIGNUP_REDIRECT_URL ||
+      process.env.SUPABASE_AUTH_REDIRECT_URL ||
+      env.lawyerSignupRedirectUrl ||
+      env.supabaseAuthRedirectUrl ||
