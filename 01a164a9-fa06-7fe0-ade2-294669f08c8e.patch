diff --git a/supabase/migrations/20261024021409_tighten_availability_and_user_identity.sql b/supabase/migrations/20261024021409_tighten_availability_and_user_identity.sql
new file mode 100644
index 0000000..fc46d9e
--- /dev/null
+++ b/supabase/migrations/20261024021409_tighten_availability_and_user_identity.sql
@@ -0,0 +1,53 @@
+-- A lawyer may manage only their own availability; admins retain full access.
+DROP POLICY IF EXISTS availability_write_lawyer_or_admin ON public.availability;
+CREATE POLICY availability_write_owner_or_admin
+ON public.availability
+FOR ALL
+TO authenticated
+USING (
+  public.is_admin()
+  OR EXISTS (
+    SELECT 1
+    FROM public.lawyers l
+    WHERE l.id = availability.lawyer_id
+      AND l.user_id = public.current_app_user_id()
+  )
+)
+WITH CHECK (
+  public.is_admin()
+  OR EXISTS (
+    SELECT 1
+    FROM public.lawyers l
+    WHERE l.id = availability.lawyer_id
+      AND l.user_id = public.current_app_user_id()
+  )
+);
+
+-- Prevent a normal user from changing account identity or privilege fields
+-- through the otherwise permitted self-profile UPDATE policy.
+CREATE OR REPLACE FUNCTION public.guard_user_identity_fields()
+RETURNS trigger
+LANGUAGE plpgsql
+SECURITY INVOKER
+SET search_path = pg_catalog, public
+AS $$
+BEGIN
+  IF (
+    NEW.id IS DISTINCT FROM OLD.id
+    OR NEW.uid IS DISTINCT FROM OLD.uid
+    OR NEW.auth_user_id IS DISTINCT FROM OLD.auth_user_id
+    OR NEW.role IS DISTINCT FROM OLD.role
+  ) AND NOT public.is_admin() THEN
+    RAISE EXCEPTION 'Identity and role fields can only be changed by an administrator'
+      USING ERRCODE = '42501';
+  END IF;
+  RETURN NEW;
+END;
+$$;
+
+REVOKE EXECUTE ON FUNCTION public.guard_user_identity_fields() FROM PUBLIC, anon, authenticated;
+DROP TRIGGER IF EXISTS guard_user_identity_fields_trigger ON public.users;
+CREATE TRIGGER guard_user_identity_fields_trigger
+BEFORE UPDATE ON public.users
+FOR EACH ROW
+EXECUTE FUNCTION public.guard_user_identity_fields();
diff --git a/supabase/migrations/20261024021423_restrict_subscription_owner_updates.sql b/supabase/migrations/20261024021423_restrict_subscription_owner_updates.sql
new file mode 100644
index 0000000..104c749
--- /dev/null
+++ b/supabase/migrations/20261024021423_restrict_subscription_owner_updates.sql
@@ -0,0 +1,36 @@
+-- Subscription owners may cancel their own subscription, but cannot rewrite
+-- plan, price snapshot, ownership, or dates. Admins retain full update access.
+CREATE OR REPLACE FUNCTION public.guard_subscription_owner_update()
+RETURNS trigger
+LANGUAGE plpgsql
+SECURITY INVOKER
+SET search_path = pg_catalog, public
+AS $$
+BEGIN
+  IF NOT public.is_admin() THEN
+    IF NEW.user_id IS DISTINCT FROM OLD.user_id
+       OR NEW.plan_id IS DISTINCT FROM OLD.plan_id
+       OR NEW.plan_title IS DISTINCT FROM OLD.plan_title
+       OR NEW.start_date IS DISTINCT FROM OLD.start_date
+       OR NEW.end_date IS DISTINCT FROM OLD.end_date
+       OR NEW.created_at IS DISTINCT FROM OLD.created_at
+       OR (
+         NEW.status IS DISTINCT FROM OLD.status
+         AND NEW.status <> 'Cancelled'
+       )
+       OR NEW.status <> 'Cancelled'
+    THEN
+      RAISE EXCEPTION 'Users may only cancel their own subscription'
+        USING ERRCODE = '42501';
+    END IF;
+  END IF;
+  RETURN NEW;
+END;
+$$;
+
+REVOKE EXECUTE ON FUNCTION public.guard_subscription_owner_update() FROM PUBLIC, anon, authenticated;
+DROP TRIGGER IF EXISTS guard_subscription_owner_update_trigger ON public.subscriptions;
+CREATE TRIGGER guard_subscription_owner_update_trigger
+BEFORE UPDATE ON public.subscriptions
+FOR EACH ROW
+EXECUTE FUNCTION public.guard_subscription_owner_update();
