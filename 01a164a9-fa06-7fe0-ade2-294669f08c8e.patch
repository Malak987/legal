+Map<String, dynamic> _lawyer(String id, String name) => <String, dynamic>{
+      'id': id,
+      'name': name,
+      'price': 'EGP 500 / hour',
+      'rating': 4.6,
+      'location': 'Sohag',
+      'specialty': 'Family law',
+    };
+
+Map<String, dynamic> _page(
+  List<Map<String, dynamic>> items, {
+  required int page,
+  required int total,
+  int limit = 20,
+  int? totalPages,
+}) =>
+    <String, dynamic>{
+      'items': items,
+      'page': page,
+      'limit': limit,
+      'total': total,
+      'totalPages': totalPages ?? (total == 0 ? 1 : ((total + limit - 1) ~/ limit)),
+    };
+
+Future<void> _pumpWithApi(
+  WidgetTester tester,
+  Widget child, {
+  required Future<http.Response> Function(http.Request request) handler,
+}) async {
+  final api = ApiClient(
+    baseUrl: 'http://test.local/api',
+    client: MockClient((request) {
+      if (request.url.path == '/api/categories') {
+        return Future<http.Response>.value(jsonOk(<String, dynamic>{
+          'items': <Map<String, dynamic>>[
+            <String, dynamic>{
+              'id': 'family-law',
+              'name': 'Family law',
+              'slug': 'family-law',
+            },
+          ],
+        }));
+      }
+      return handler(request);
+    }),
+    currentUidProvider: () => null,
+  );
+  final gateway = FakeAuthGateway();
+  final session = SessionController(
+    auth: AuthService(gateway: gateway, api: api),
+  );
+  addTearDown(api.dispose);
+  addTearDown(session.dispose);
+  addTearDown(gateway.dispose);
+
+  await tester.pumpWidget(
+    SessionScope(
+      controller: session,
+      child: MaterialApp(home: child),
+    ),
+  );
+  await tester.pump();
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  group('SearchScreen catalogue pagination', () {
+    testWidgets('debounces search and loads the next page for that query',
+        (tester) async {
+      final requests = <http.Request>[];
+      await _pumpWithApi(
+        tester,
+        const SearchScreen(),
+        handler: (request) async {
+          requests.add(request);
+          final query = request.url.queryParameters['search'] ?? '';
+          final page = int.parse(request.url.queryParameters['page'] ?? '1');
+          if (query == 'Nour') {
+            return jsonOk(_page(
+              <Map<String, dynamic>>[
+                _lawyer('nour-$page', page == 1 ? 'Nour Hassan' : 'Nour Ali'),
+              ],
+              page: page,
+              total: 21,
+            ));
+          }
+          return jsonOk(_page(
+            <Map<String, dynamic>>[_lawyer('initial-1', 'Initial Lawyer')],
+            page: 1,
+            total: 1,
+          ));
+        },
+      );
+      await tester.pumpAndSettle();
+      expect(find.text('Initial Lawyer'), findsOneWidget);
+
+      await tester.enterText(find.byType(TextField), 'Nour');
+      await tester.pump(const Duration(milliseconds: 400));
+      await tester.pumpAndSettle();
+      expect(find.text('Nour Hassan'), findsOneWidget);
+      expect(find.text('Load more'), findsOneWidget);
+
+      await tester.tap(find.text('Load more'));
+      await tester.pumpAndSettle();
+
+      expect(find.text('Nour Ali'), findsOneWidget);
+      expect(requests.map((request) => request.url.queryParameters['page']),
+          ['1', '1', '2']);
+      expect(requests.last.url.queryParameters['search'], 'Nour');
+    });
+
+    testWidgets('filters lawyers when a category chip is selected',
+        (tester) async {
+      final lawyerRequests = <http.Request>[];
+      await _pumpWithApi(
+        tester,
+        const SearchScreen(),
+        handler: (request) async {
+          lawyerRequests.add(request);
+          final categoryId = request.url.queryParameters['categoryId'];
+          final items = categoryId == 'family-law'
+              ? <Map<String, dynamic>>[
+                  _lawyer('family-lawyer', 'Filtered family lawyer'),
+                ]
+              : <Map<String, dynamic>>[
+                  _lawyer('general-lawyer', 'General lawyer'),
+                ];
+          return jsonOk(_page(items, page: 1, total: items.length));
+        },
+      );
+      await tester.pumpAndSettle();
+      expect(find.text('General lawyer'), findsOneWidget);
+
+      await tester.tap(find.widgetWithText(ChoiceChip, 'Family law'));
+      await tester.pumpAndSettle();
+
+      expect(find.text('Filtered family lawyer'), findsOneWidget);
+      expect(lawyerRequests.last.url.queryParameters['categoryId'], 'family-law');
+    });
+
+    testWidgets('renders loading, empty and retryable error states',
+        (tester) async {
+      final pending = Completer<http.Response>();
+      var requests = 0;
+      await _pumpWithApi(
+        tester,
+        const SearchScreen(),
+        handler: (request) async {
+          requests++;
+          if (requests == 1) return pending.future;
+          if (request.url.queryParameters['search'] == 'broken' && requests == 2) {
+            return jsonError(403, 'Catalogue access denied.');
+          }
+          return jsonOk(_page(
+            <Map<String, dynamic>>[],
+            page: 1,
+            total: 0,
+          ));
+        },
+      );
+
+      expect(find.byType(CircularProgressIndicator), findsOneWidget);
+      pending.complete(jsonOk(_page(<Map<String, dynamic>>[], page: 1, total: 0)));
+      await tester.pumpAndSettle();
+      expect(find.text('No lawyers listed yet'), findsOneWidget);
+
+      await tester.enterText(find.byType(TextField), 'broken');
+      await tester.pump(const Duration(milliseconds: 400));
+      await tester.pumpAndSettle();
+      expect(find.text('Search failed'), findsOneWidget);
+      expect(find.text('Catalogue access denied.'), findsOneWidget);
+      expect(find.text('Try again'), findsOneWidget);
+
+      await tester.tap(find.text('Try again'));
+      await tester.pumpAndSettle();
+      expect(find.text('No lawyers found'), findsOneWidget);
+    });
+  });
+
+  group('PopularLawyersScreen pagination', () {
+    testWidgets('keeps the popular filter while loading another page',
+        (tester) async {
+      final requests = <http.Request>[];
+      await _pumpWithApi(
+        tester,
+        const PopularLawyersScreen(),
+        handler: (request) async {
+          requests.add(request);
+          final page = int.parse(request.url.queryParameters['page'] ?? '1');
+          return jsonOk(_page(
+            <Map<String, dynamic>>[
+              _lawyer('popular-$page', page == 1 ? 'Popular One' : 'Popular Two'),
+            ],
+            page: page,
+            total: 21,
+          ));
+        },
+      );
+      await tester.pumpAndSettle();
+
+      expect(find.text('Popular One'), findsOneWidget);
+      await tester.tap(find.text('Load more'));
+      await tester.pumpAndSettle();
+
+      expect(find.text('Popular Two'), findsOneWidget);
+      expect(requests.map((request) => request.url.queryParameters['page']), ['1', '2']);
+      expect(requests.every((request) => request.url.queryParameters['isPopular'] == 'true'),
+          isTrue);
+    });
+
+    testWidgets('keeps the top-rated filter while loading another page',
+        (tester) async {
+      final requests = <http.Request>[];
+      await _pumpWithApi(
+        tester,
+        const PopularLawyersScreen(onlyTop: true, title: 'Top Lawyers'),
+        handler: (request) async {
+          requests.add(request);
+          final page = int.parse(request.url.queryParameters['page'] ?? '1');
+          return jsonOk(_page(
+            <Map<String, dynamic>>[
+              _lawyer('top-$page', page == 1 ? 'Top One' : 'Top Two'),
+            ],
+            page: page,
+            total: 21,
+          ));
+        },
+      );
+      await tester.pumpAndSettle();
+
+      expect(find.text('Top One'), findsOneWidget);
+      await tester.tap(find.text('Load more'));
+      await tester.pumpAndSettle();
+
+      expect(find.text('Top Two'), findsOneWidget);
+      expect(requests.every((request) => request.url.queryParameters['isTop'] == 'true'),
+          isTrue);
+      expect(requests.every((request) => !request.url.queryParameters.containsKey('isPopular')),
+          isTrue);
+    });
+  });
+
+  testWidgets('a missing detail does not keep rendering its passed list item',
+      (tester) async {
+    final lawyerRequests = <http.Request>[];
+    await _pumpWithApi(
+      tester,
+      LegalServiceDetailsScreen(
+        lawyer: Product(
+          id: 'removed-lawyer',
+          imagePath: '',
+          name: 'Stale list entry',
+          price: 'EGP 500 / hour',
+        ),
+        lawyerId: 'removed-lawyer',
+      ),
+      handler: (request) async {
+        if (request.url.path == '/api/lawyers/removed-lawyer') {
+          lawyerRequests.add(request);
+          return jsonError(404, 'Lawyer not found');
+        }
+        return jsonOk(<Map<String, dynamic>>[]);
+      },
+    );
+    await tester.pumpAndSettle();
+
+    expect(lawyerRequests, hasLength(1));
+    expect(find.text('This lawyer is no longer available.'), findsOneWidget);
+    expect(find.text('Stale list entry'), findsNothing);
+  });
+}
diff --git a/legal_app/test/supabase_ai_client_test.dart b/legal_app/test/supabase_ai_client_test.dart
new file mode 100644
index 0000000..8920c62
--- /dev/null
+++ b/legal_app/test/supabase_ai_client_test.dart
@@ -0,0 +1,151 @@
+import 'dart:convert';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:legalserviceapp/services/api_client.dart';
+
+void main() {
+  const supabaseUrl = 'https://project.example.supabase.co';
+  const anonKey = 'public-anon-key';
+  const accessToken = 'supabase-user-jwt';
+  const authUid = '00000000-0000-4000-8000-000000000099';
+  const profileId = 'client_legal_001';
+
+  ApiClient makeClient(Future<http.Response> Function(http.Request) handler) =>
+      ApiClient(
+        supabaseUrl: supabaseUrl,
+        supabaseAnonKey: anonKey,
+        client: MockClient(handler),
+        idTokenProvider: () async => accessToken,
+        currentUidProvider: () => authUid,
+      );
+
+  http.Response profileResponse() => http.Response(
+        jsonEncode([
+          {
+            'id': profileId,
+            'uid': profileId,
+            'name': 'Client One',
+            'email': 'client@example.test',
+            'role': 'client',
+          },
+        ]),
+        200,
+        headers: {'content-type': 'application/json'},
+      );
+
+  test('uploads validated PDF bytes through the trusted Edge Function', () async {
+    const pdfBytes = <int>[0x25, 0x50, 0x44, 0x46, 0x2d, 0x31, 0x2e, 0x37];
+    const objectPath = '$profileId/documents/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.pdf';
+    final requests = <http.Request>[];
+    final client = makeClient((request) async {
+      requests.add(request);
+      if (request.url.path == '/rest/v1/users') return profileResponse();
+      return http.Response(
+        jsonEncode({'object_path': objectPath}),
+        201,
+        headers: {'content-type': 'application/json'},
+      );
+    });
+    addTearDown(client.dispose);
+
+    final path = await client.uploadPrivatePdf(pdfBytes);
+    final upload = requests.last;
+
+    expect(path, objectPath);
+    expect(requests, hasLength(2));
+    expect(requests.first.url.path, '/rest/v1/users');
+    expect(upload.method, 'POST');
+    expect(upload.url.origin, supabaseUrl);
+    expect(upload.url.path, '/functions/v1/document-upload');
+    expect(upload.headers['apikey'], anonKey);
+    expect(upload.headers['Authorization'], 'Bearer $accessToken');
+    expect(upload.headers['Content-Type'], 'application/pdf');
+    expect(upload.headers.containsKey('x-upsert'), isFalse);
+    expect(upload.bodyBytes, pdfBytes);
+  });
+
+  test('invokes an Edge Function with a JWT and JSON, not a provider secret', () async {
+    late http.Request captured;
+    final client = makeClient((request) async {
+      captured = request;
+      return http.Response(
+        jsonEncode({'answer': 'General information only.', 'advisory': true}),
+        200,
+        headers: {'content-type': 'application/json'},
+      );
+    });
+    addTearDown(client.dispose);
+
+    final response = await client.invokeSupabaseFunction('ai-assistant', {
+      'action': 'legal_chat',
+      'question': 'What does a lease usually contain?',
+    });
+
+    expect(captured.method, 'POST');
+    expect(captured.url.path, '/functions/v1/ai-assistant');
+    expect(captured.headers['apikey'], anonKey);
+    expect(captured.headers['Authorization'], 'Bearer $accessToken');
+    expect(captured.headers.containsKey('x-goog-api-key'), isFalse);
+    expect(jsonDecode(captured.body), {
+      'action': 'legal_chat',
+      'question': 'What does a lease usually contain?',
+    });
+    expect(response['answer'], 'General information only.');
+    expect(response['advisory'], isTrue);
+  });
+
+  test('refuses cross-owner temporary PDF cleanup before Storage deletion', () async {
+    final requests = <http.Request>[];
+    final client = makeClient((request) async {
+      requests.add(request);
+      if (request.url.path == '/rest/v1/users') return profileResponse();
+      return http.Response('{}', 200);
+    });
+    addTearDown(client.dispose);
+
+    await expectLater(
+      client.deletePrivatePdf('another_user/documents/report_1.pdf'),
+      throwsA(isA<ApiException>().having((error) => error.statusCode, 'statusCode', 403)),
+    );
+    expect(requests, hasLength(1));
+    expect(requests.single.url.path, '/rest/v1/users');
+  });
+
+  test('rejects an invalid PDF signature before contacting Supabase', () async {
+    var requests = 0;
+    final client = makeClient((_) async {
+      requests++;
+      return profileResponse();
+    });
+    addTearDown(client.dispose);
+
+    await expectLater(
+      client.uploadPrivatePdf(const <int>[0, 1, 2, 3, 4]),
+      throwsA(isA<ApiException>().having((error) => error.statusCode, 'statusCode', 415)),
+    );
+    expect(requests, 0);
+  });
+
+  test('surfaces a failed trusted upload rather than reporting success', () async {
+    final requests = <http.Request>[];
+    final client = makeClient((request) async {
+      requests.add(request);
+      if (request.url.path == '/rest/v1/users') return profileResponse();
+      return http.Response(
+        jsonEncode({'error': 'DOCUMENT_UPLOAD_FAILED'}),
+        502,
+        headers: {'content-type': 'application/json'},
+      );
+    });
+    addTearDown(client.dispose);
+
+    await expectLater(
+      client.uploadPrivatePdf(const <int>[0x25, 0x50, 0x44, 0x46, 0x2d, 0x31]),
+      throwsA(isA<ApiException>().having((error) => error.statusCode, 'statusCode', 502)),
+    );
+    expect(requests, hasLength(2));
+    expect(requests.last.url.path, '/functions/v1/document-upload');
+  });
+}
