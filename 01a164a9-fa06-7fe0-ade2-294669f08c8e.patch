+          setState(() {
+            _lawyer = null;
+            _reviews = const <Map<String, dynamic>>[];
+            _availability = const <LawyerAvailability>[];
+            _favoriteId = null;
+            _error = 'This lawyer is no longer available.';
+            _loading = false;
+          });
+          return;
+        }
+        loaded = fetched;
+      } else if (loaded == null) {
+        final list = await repo.fetchLawyers();
+        if (list.isNotEmpty) {
+          loaded = list.first;
+          targetId = (loaded.id ?? '').trim();
+        }
