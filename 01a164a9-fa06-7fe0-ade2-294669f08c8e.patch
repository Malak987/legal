+                ],
+              },
+            }),
+            200,
+            headers: <String, String>{'content-type': 'application/json'},
+          );
+        }),
+        currentUidProvider: () => null,
+      );
+      addTearDown(api.dispose);
+
+      final categories = await AppRepository(api).fetchCategories(search: 'family');
+
+      expect(request.method, 'GET');
