+
+Future<void> _drain(WidgetTester tester, {int frames = 4}) async {
+  for (var f = 0; f < frames; f++) {
+    await tester.runAsync(() async {
+      for (var i = 0; i < 25; i++) {
+        await Future<void>.delayed(const Duration(milliseconds: 2));
+      }
+    });
+    await tester.pump(const Duration(milliseconds: 16));
+  }
+}
+
+Future<SessionController> _pumpSignedIn(
+  WidgetTester tester,
+  Widget child, {
+  required Future<http.Response> Function(http.Request request, int attempt)
+      handler,
+  String role = 'client',
+}) async {
+  final gateway = FakeAuthGateway();
+  final session = SessionController(
+    auth: AuthService(
+      gateway: gateway,
+      api: testApiClient(
+        handler: (request, attempt) async {
+          if (request.url.path.endsWith('/users/uid-1') &&
+              request.method == 'GET') {
+            return jsonOk(profileJson(role: role));
+          }
+          return handler(request, attempt);
+        },
+      ),
+    ),
+  );
+  addTearDown(session.dispose);
+
+  session.start();
+  gateway.emit(const AuthUser(uid: 'uid-1', email: 'sara@example.com'));
+  await _drain(tester);
+
+  await tester.pumpWidget(
+    SessionScope(
+      controller: session,
+      child: MaterialApp(home: child),
+    ),
+  );
+  await _drain(tester);
+  return session;
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  group('CaseDetailsScreen', () {
+    testWidgets('loads a caller-authorized case by its stable ID',
+        (tester) async {
+      final requests = <String>[];
+      await _pumpSignedIn(
+        tester,
+        const CaseDetailsScreen(caseId: 'case-1'),
+        handler: (req, _) async {
+          requests.add('${req.method} ${req.url.path}');
+          if (req.url.path.endsWith('/cases/case-1') &&
+              req.method == 'GET') {
+            return jsonOk({
+              'id': 'case-1',
+              'title': 'Contract dispute',
+              'clientName': 'Nour Hassan',
+              'categoryName': 'Commercial Law',
+              'lawyerName': 'Mona Fahmy',
+              'status': 'In Progress',
+              'priority': 'High',
+              'dueDate': '2026-12-02',
+              'description': 'Review disputed termination terms.',
+            });
+          }
+          return jsonOk(<String, dynamic>{});
+        },
+      );
+
+      expect(requests, contains('GET /api/cases/case-1'));
+      expect(find.text('Contract dispute'), findsOneWidget);
+      expect(find.text('Commercial Law'), findsOneWidget);
+      expect(find.text('Mona Fahmy'), findsOneWidget);
+      expect(find.text('Review disputed termination terms.'), findsOneWidget);
+      expect(find.text('Evidence'), findsNothing);
+      expect(find.text('Last Hearing'), findsNothing);
+    });
+  });
+
+  group('Booking history screens', () {
+    testWidgets('OrdersHistory builds sections from GET /api/bookings',
+        (tester) async {
+      await _pumpSignedIn(
+        tester,
+        const OrdersHistory(),
+        handler: (req, _) async {
+          if (req.url.path.endsWith('/bookings') && req.method == 'GET') {
+            return jsonOk({
+              'items': [
+                {
+                  'id': 'booking-active',
+                  'lawyerName': 'Mona Fahmy',
+                  'date': '2026-11-10',
+                  'time': '09:00',
+                  'status': 'Pending',
+                  'totalPrice': 150,
+                },
+                {
+                  'id': 'booking-done',
+                  'lawyerName': 'Karim Nassar',
+                  'date': '2026-10-01',
+                  'time': '11:00',
+                  'status': 'Completed',
+                  'totalPrice': 200,
+                },
+              ],
+              'total': 2,
+            });
+          }
+          return jsonOk(<String, dynamic>{});
+        },
+      );
+
+      expect(find.text('Active Bookings (1)'), findsOneWidget);
+      expect(find.text('Completed Bookings (1)'), findsOneWidget);
+      expect(find.text('Mona Fahmy'), findsOneWidget);
+      expect(find.text('Karim Nassar'), findsOneWidget);
+    });
+
+    testWidgets('ActiveOrders cancels an existing booking via PUT /api/bookings/:id',
+        (tester) async {
+      var status = 'Pending';
+      final calls = <String>[];
+      await _pumpSignedIn(
+        tester,
+        const ActiveOrders(),
+        handler: (req, _) async {
+          calls.add('${req.method} ${req.url.path}');
+          if (req.url.path.endsWith('/bookings') && req.method == 'GET') {
+            return jsonOk({
+              'items': [
+                {
+                  'id': 'booking-1',
+                  'lawyerName': 'Mona Fahmy',
+                  'date': '2026-11-10',
+                  'time': '09:00',
+                  'hours': 1,
+                  'totalPrice': 150,
+                  'status': status,
+                },
+              ],
+              'total': 1,
+            });
+          }
+          if (req.url.path.endsWith('/bookings/booking-1') &&
+              req.method == 'PUT') {
+            status = (jsonDecode(req.body) as Map<String, dynamic>)['status']
+                .toString();
+            return jsonOk({'id': 'booking-1', 'status': status});
+          }
+          return jsonOk(<String, dynamic>{});
+        },
+      );
+
+      expect(find.text('Mona Fahmy'), findsOneWidget);
+      await tester.tap(find.text('Cancel'));
+      await tester.pumpAndSettle();
